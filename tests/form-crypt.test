# getForms, fillForms und exportForms auf verschluesselter Eingabe  -*-tcl-*-
#
# Bis 0.9.4.70 lasen alle drei eine verschluesselte Datei, als waere sie
# Klartext. Die Feldnamen stehen dort verschluesselt (/T <8faeb26e...>),
# FormFieldTree fand kein Feld, und keiner der drei Befehle sagte etwas:
#
#   getForms     leeres dict
#   fillForms    "no such field(s)"
#   exportForms  leere FDF und 0 -- das dokumentierte -password wurde
#                angenommen und nie benutzt
#
# Gemessen an Dateien, die pdf4tcl selbst geschrieben hatte. Seit 0.9.4.71
# nehmen alle drei -password, und ohne die Option wird mit dem leeren
# Kennwort gelesen -- eine Datei mit nur einem Eigentuemerkennwort geht
# damit auf wie in jedem Betrachter.

source [file join [file dirname [file join [pwd] [info script]]] init.tcl]

# Ein Formular mit drei Feldern, verschluesselt geschrieben.
proc encForm {name opts} {
    set f [makeFile {} $name]
    set p [pdf4tcl::new %AUTO% -paper a4 {*}$opts]
    $p startPage
    $p setFont 12 Helvetica
    $p addForm text 50 50 200 20 -id name -init "Meier"
    $p addForm checkbutton 50 100 20 20 -id ok -init 1
    $p addForm combobox 50 150 120 20 -id farbe \
            -options {Rot Gruen Blau} -init Rot
    $p write -file $f
    $p destroy
    return $f
}

proc formValues {r} {
    list [dict get $r name value] [dict get $r ok value] [dict get $r farbe value]
}

proc readBytes {f} {
    set ch [open $f rb]
    set d [read $ch]
    close $ch
    return $d
}

# Objekttexte einer Datei: Nummer -> Text
proc objTexts {f} {
    set out {}
    # \d+? und nicht \d+: in Tcl bestimmt der ERSTE Quantor, ob der ganze
    # Ausdruck gierig ist -- mit \d+ liefe .*? ueber mehrere Objekte.
    foreach {- n body} [regexp -all -inline {\n(\d+?) 0 obj(.*?)endobj} \
            [readBytes $f]] {
        dict set out $n $body
    }
    return $out
}

set ::encOwner [encForm enc-owner.pdf {-ownerpassword geheim}]
set ::encUser  [encForm enc-user.pdf  {-userpassword u -ownerpassword o}]

# ---------------------------------------------------------------
# 1. getForms
# ---------------------------------------------------------------

test formcrypt-1.1 {nur Eigentuemerkennwort: liest ohne -password} -body {
    formValues [pdf4tcl::getForms $::encOwner]
} -result {Meier /Yes Rot}

test formcrypt-1.2 {Benutzerkennwort fehlt: Fehler statt leerem dict} -body {
    catch {pdf4tcl::getForms $::encUser} e opts
    list [dict get $opts -errorcode] [string match "*-password*" $e]
} -result {{PDF4TCL PASSWORD} 1}

test formcrypt-1.3 {mit dem Benutzerkennwort} -body {
    formValues [pdf4tcl::getForms $::encUser -password u]
} -result {Meier /Yes Rot}

test formcrypt-1.4 {mit dem Eigentuemerkennwort} -body {
    formValues [pdf4tcl::getForms $::encUser -password o]
} -result {Meier /Yes Rot}

test formcrypt-1.5 {falsches Kennwort} -body {
    catch {pdf4tcl::getForms $::encUser -password falsch} e opts
    list [dict get $opts -errorcode] [string match "wrong password*" $e]
} -result {{PDF4TCL PASSWORD} 1}

test formcrypt-1.6 {falsches Kennwort schadet nicht, wo keines noetig ist} -body {
    formValues [pdf4tcl::getForms $::encOwner -password falsch]
} -result {Meier /Yes Rot}

test formcrypt-1.7 {unbekannte Option} -body {
    pdf4tcl::getForms $::encOwner -passwort u
} -returnCodes 1 -result {getForms: unknown option "-passwort", must be -password}

test formcrypt-1.8 {Option ohne Wert} -body {
    pdf4tcl::getForms $::encOwner -password
} -returnCodes 1 -result {getForms: missing value for option "-password"}

# ---------------------------------------------------------------
# 2. fillForms
# ---------------------------------------------------------------

test formcrypt-2.1 {fuellen und wieder lesen} -body {
    set aus [makeFile {} enc-user-voll.pdf]
    set n [pdf4tcl::fillForms $::encUser $aus \
            [list name "Schmidt (neu) \u00e4" ok /Off farbe Blau] -password u]
    list $n [formValues [pdf4tcl::getForms $aus -password u]]
} -cleanup {
    removeFile enc-user-voll.pdf
} -result [list 3 [list "Schmidt (neu) \u00e4" /Off Blau]]

test formcrypt-2.2 {die Ausgabe bleibt verschluesselt} -body {
    set aus [makeFile {} enc-user-voll.pdf]
    pdf4tcl::fillForms $::encUser $aus {name Schmidt} -password u
    catch {pdf4tcl::getForms $aus} e opts
    list [dict get $opts -errorcode] \
         [regexp {/Encrypt\s+\d+\s+0\s+R} [readBytes $aus]]
} -cleanup {
    removeFile enc-user-voll.pdf
} -result {{PDF4TCL PASSWORD} 1}

test formcrypt-2.3 {der neue Wert steht nirgends im Klartext} -body {
    # Weder in /V noch im neu gebauten Appearance-Strom. Hier wuerde eine
    # Wiederverschluesselung auffallen, die einen Teil vergisst.
    set aus [makeFile {} enc-user-voll.pdf]
    pdf4tcl::fillForms $::encUser $aus {name Schmidtchen} -password u
    string first Schmidtchen [readBytes $aus]
} -cleanup {
    removeFile enc-user-voll.pdf
} -result -1

test formcrypt-2.4 {unberuehrte Objekte gehen byteweise so hinaus} -body {
    # Nur die Felder, ihre Erscheinungen und /AcroForm aendern sich. Alles
    # andere -- Seite, Schriften, /Encrypt -- kommt so heraus, wie es kam.
    set aus [makeFile {} enc-user-voll.pdf]
    pdf4tcl::fillForms $::encUser $aus {name Schmidt} -password u
    set a [objTexts $::encUser]
    set b [objTexts $aus]
    set gleich 0
    set anders 0
    dict for {n t} $a {
        if {[dict exists $b $n] && [dict get $b $n] eq $t} {
            incr gleich
        } else {
            incr anders
        }
    }
    regexp {/Encrypt\s+(\d+)} [readBytes $aus] -> encObj
    list [expr {$gleich > $anders}] \
         [expr {[dict get $a $encObj] eq [dict get $b $encObj]}]
} -cleanup {
    removeFile enc-user-voll.pdf
} -result {1 1}

test formcrypt-2.5 {ohne Kennwort: Fehler, keine Ausgabe} -body {
    set aus [file join [temporaryDirectory] enc-nichts.pdf]
    file delete $aus
    catch {pdf4tcl::fillForms $::encUser $aus {name Schmidt}} e opts
    list [dict get $opts -errorcode] [file exists $aus]
} -result {{PDF4TCL PASSWORD} 0}

# ---------------------------------------------------------------
# 3. exportForms -- -password war dokumentiert und wirkungslos
# ---------------------------------------------------------------

test formcrypt-3.1 {exportForms reicht -password weiter} -body {
    set aus [makeFile {} enc.xfdf]
    set n [pdf4tcl::exportForms $::encUser $aus -format xfdf -password u]
    list $n [string match "*<value>Meier</value>*" [readBytes $aus]]
} -cleanup {
    removeFile enc.xfdf
} -result {3 1}

test formcrypt-3.2 {exportForms ohne Kennwort: Fehler statt leerer Datei} -body {
    set aus [makeFile {} enc.fdf]
    catch {pdf4tcl::exportForms $::encUser $aus} e opts
    dict get $opts -errorcode
} -cleanup {
    removeFile enc.fdf
} -result {PDF4TCL PASSWORD}

# ---------------------------------------------------------------
# 4. Fremde Erzeuger: RC4, AES-256, Objekt-Stroeme
#
# pdf4tcl schreibt nur AES-128 und AES-256 (R 6), ohne Objekt-Stroeme.
# Die Fixtures sind dasselbe Formular, mit qpdf 11.9.0 verschluesselt:
#
#   qpdf --allow-weak-crypto --encrypt u o 40 -- base.pdf form-enc-rc4-40.pdf
#   qpdf --allow-weak-crypto --encrypt u o 128 --use-aes=n -- \
#        --object-streams=generate base.pdf form-enc-rc4-128-objstm.pdf
#   qpdf --encrypt "" o 128 --use-aes=y -- \
#        --object-streams=generate base.pdf form-enc-aes128-objstm-owner.pdf
#   qpdf --encrypt u o 256 --force-R5 -- base.pdf form-enc-aes256-r5.pdf
#   qpdf --encrypt u o 256 -- \
#        --object-streams=generate base.pdf form-enc-aes256-r6.pdf
#
# base.pdf ist encForm ohne Verschluesselung. Bei den Objekt-Stroemen ist
# der Container als Ganzes verschluesselt, die Objekte darin nicht -- und
# beim Schreiben werden sie zu eigenen Objekten, die es dann sein muessen.
# ---------------------------------------------------------------

proc fixture {name} {
    file join $::pdf4tclTestRoot tests fixtures $name
}
foreach {c f} {
    haveRc440      form-enc-rc4-40.pdf
    haveRc4ObjStm  form-enc-rc4-128-objstm.pdf
    haveAesObjStm  form-enc-aes128-objstm-owner.pdf
    haveAes256R5   form-enc-aes256-r5.pdf
    haveAes256R6   form-enc-aes256-r6.pdf
} {
    testConstraint $c [file exists [fixture $f]]
}

test formcrypt-4.1 {RC4 40 Bit (R 2)} -constraints haveRc440 -body {
    formValues [pdf4tcl::getForms [fixture form-enc-rc4-40.pdf] -password u]
} -result {Meier /Yes Rot}

test formcrypt-4.2 {RC4 128 Bit mit Objekt-Stroemen (R 3)} \
        -constraints haveRc4ObjStm -body {
    formValues [pdf4tcl::getForms [fixture form-enc-rc4-128-objstm.pdf] \
            -password o]
} -result {Meier /Yes Rot}

test formcrypt-4.3 {AES-128 mit Objekt-Stroemen, nur Eigentuemerkennwort} \
        -constraints haveAesObjStm -body {
    formValues [pdf4tcl::getForms [fixture form-enc-aes128-objstm-owner.pdf]]
} -result {Meier /Yes Rot}

test formcrypt-4.4 {AES-256 R 5} -constraints haveAes256R5 -body {
    formValues [pdf4tcl::getForms [fixture form-enc-aes256-r5.pdf] -password u]
} -result {Meier /Yes Rot}

test formcrypt-4.5 {AES-256 R 6 von qpdf (Alg. 2.B, einige Sekunden)} \
        -constraints haveAes256R6 -body {
    formValues [pdf4tcl::getForms [fixture form-enc-aes256-r6.pdf] -password u]
} -result {Meier /Yes Rot}

test formcrypt-4.6 {Objekte aus Objekt-Stroemen werden verschluesselt geschrieben} \
        -constraints haveRc4ObjStm -body {
    set aus [makeFile {} rc4-voll.pdf]
    pdf4tcl::fillForms [fixture form-enc-rc4-128-objstm.pdf] $aus \
            {name Schmidtchen farbe Gruen} -password u
    list [formValues [pdf4tcl::getForms $aus -password u]] \
         [string first Schmidtchen [readBytes $aus]] \
         [string first Gruen [readBytes $aus]]
} -cleanup {
    removeFile rc4-voll.pdf
} -result {{Schmidtchen /Yes Gruen} -1 -1}

test formcrypt-4.7 {AES-256 R 5: fuellen und wieder lesen} \
        -constraints haveAes256R5 -body {
    set aus [makeFile {} r5-voll.pdf]
    pdf4tcl::fillForms [fixture form-enc-aes256-r5.pdf] $aus \
            {name Schmidtchen ok /Off} -password o
    list [formValues [pdf4tcl::getForms $aus -password u]] \
         [string first Schmidtchen [readBytes $aus]]
} -cleanup {
    removeFile r5-voll.pdf
} -result {{Schmidtchen /Off Rot} -1}

# ---------------------------------------------------------------
# 5. catPdf bleibt, wie es war
# ---------------------------------------------------------------

test formcrypt-5.1 {ReadPdf ohne -password entschluesselt nichts} -body {
    set d [pdf4tcl::cat::ReadPdf $::encOwner]
    list [dict exists $d crypt] \
         [regexp {/T\s*<[0-9a-fA-F]+>} [readBytes $::encOwner]]
} -result {0 1}

test formcrypt-5.2 {ReadPdf: unbekannte Option} -body {
    pdf4tcl::cat::ReadPdf $::encOwner -passwort x
} -returnCodes 1 -result {ReadPdf: unknown option "-passwort"}

removeFile enc-owner.pdf
removeFile enc-user.pdf

::tcltest::cleanupTests
