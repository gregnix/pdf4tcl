# Test form commands                                                 -*-tcl-*-
#
# $Id$

source [file join [file dirname [file join [pwd] [info script]]] init.tcl]

test form-1.1 {addForm method, errors} -body {
    mytest {addForm apa 0 0 10 10} {
    }
} -returnCodes 1 -result "unknown form type apa"

test form-1.2 {addForm method, errors} -body {
    mytest {addForm checkbutton 0 0 10 10 -init hej} {
    }
} -returnCodes 1 -result "initial value for checkbutton must be boolean"

test form-1.3 {addForm method, errors} -body {
    mytest {addForm checkbutton 0 0 10 10 -on hej} {
    }
} -returnCodes 1 -result "bad id for -on"

test form-1.4 {addForm method, errors} -body {
    mytest {addForm checkbutton 0 0 10 10 -off hej} {
    }
} -returnCodes 1 -result "bad id for -off"

test form-1.5 {addForm method, errors} -body {
    mytest {addForm text 0 0 10 10 -multiline hej} {
    }
} -returnCodes 1 -result "option -multiline must have a boolean value"

test form-1.6 {addForm method, errors} -body {
    mytest {addForm text 0 0 10 10 -id 6.7} {
    }
} -returnCodes 1 -result "option -id must be alphanumeric"

test form-2.1 {addForm method, text} -body {
    mytest -all {addForm text 0 0 10 10} {
        /Subtype /Widget * /FT /Tx /T * /DA
    }
} -result 1

test form-2.2 {addForm method, text} -body {
    mytest -all {addForm text 0 0 10 10 -init Hurga} {
        /Subtype /Widget * /FT /Tx /T * /DA * /V (Hurga)
    }
} -result 1

test form-2.3 {addForm method, text} -body {
    mytest -all {addForm text 0 0 10 10 -id MyPrecious} {
        /Subtype /Widget * /FT /Tx /T (MyPrecious) /DA
    }
} -result 1

test form-3.1 {addForm method, checkbutton} -body {
    mytest -all {addForm checkbutton 0 0 10 10} {
        /Subtype /Widget * /FT /Btn /T * /AS /Off
    }
} -result 1

test form-3.2 {addForm method, checkbutton} -body {
    mytest -all {addForm checkbutton 0 0 10 10 -init true} {
        /Subtype /Widget * /FT /Btn /T * /AS /Yes
    }
} -result 1

test form-3.3 {addForm method, checkbutton} -body {
    mytest -all {addForm checkbutton 0 0 10 10 -id TheSuperForm} {
        /Subtype /Widget * /FT /Btn /T (TheSuperForm) /AS /Off
    }
} -result 1

test form-4.1 {getForms command} -body {
    mytest -file {addForm text 0 0 10 10 -id MyPrecious} {}
    pdf4tcl::getForms testdebug.pdf
    # Die Rueckgabe ist in 0.9.4.63 um maxlen und comb gewachsen, in
    # 0.9.4.64 um widgets, in 0.9.4.65 um description und options. Ein Test, der das ganze dict festnagelt,
    # meldet jede Erweiterung -- hier zu Recht: die Rueckgabe ist Teil
    # der zugesagten Schnittstelle und steht so in der manpage.
    #
    # "widgets" ist die sichtbare Haelfte des Durchschlagsatzes: ohne
    # den Schluessel sagt getForms ueber ein Feld mit mehreren Widgets
    # gar nichts. Die Reihenfolge im dict aendert sich mit, weil
    # "default" jetzt erst nach den Widgets bekannt ist -- ein dict
    # vergleicht als Liste, darum steht es hier hinten.
} -cleanup {file delete testdebug.pdf} -result [list MyPrecious [list type /Tx value {} flags 0 maxlen {} comb 0 \
        widgets 1 description {} options {}]]

test form-4.2 {getForms command} -body {
    mytest -file {addForm checkbutton 0 0 10 10 -id TheSuperForm} {}
    pdf4tcl::getForms testdebug.pdf
} -cleanup {file delete testdebug.pdf} -result [list TheSuperForm [list type /Btn value /Off flags 0 maxlen {} \
        comb 0 default /Off widgets 1 description {} options {}]]

# ---------------------------------------------------------------------------
# One /AP per widget dictionary (0.9.4.43)
# ---------------------------------------------------------------------------
#
# 0.9.4.42 added /AP for every text field. The older line that wrote it for
# fields with an initial value stayed, so such a field carried the key twice.
# ISO 32000-1 7.3.7 does not allow a duplicated key; readers take the last
# occurrence and both pointed at the same object, so nothing looked wrong --
# qpdf reported it, no reader did.

# Number of /AP keys in the first /Subtype /Widget dictionary that holds one.
proc apCount {data} {
    set idx 0
    while {[set idx [string first "/Subtype /Widget" $data $idx]] >= 0} {
        # Up to endobj, not up to the first ">>" -- that one belongs to
        # "/AP << /N 15 0 R >>" itself, and cutting there hides the very
        # duplicate this test is about.
        set stop [string first "endobj" $data $idx]
        set dict [string range $data $idx $stop]
        set n [regexp -all {/AP <<} $dict]
        if {$n > 0} { return $n }
        set idx $stop
    }
    return 0
}

test form-ap-1.1 {text field with an initial value has one /AP} -body {
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id f1 -init "Wert"
    set data [$p get]
    $p destroy
    apCount $data
} -result 1

test form-ap-1.2 {same under -pdfa} -body {
    set p [::pdf4tcl::new %AUTO% -compress 0 -pdfa 3b]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id f1 -init "Wert"
    set data [$p get]
    $p destroy
    apCount $data
} -result 1

test form-ap-1.3 {a field with a value still has an /AP at all} -body {
    # Guards the two above: without this, removing /AP entirely would make
    # them fail loudly, but a helper that finds no widget would not.
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id f1 -init "Wert"
    set data [$p get]
    $p destroy
    expr {[apCount $data] > 0}
} -result 1

# ---------------------------------------------------------------------------
# 0.9.4.63: dieselbe Diagnose wie ueberall, wenn keine Schrift gesetzt ist
# ---------------------------------------------------------------------------

test form-font-1.1 {addForm ohne setFont meldet "no font set"} -body {
    # Vorher brach der Aufruf mit einer INTERNEN Meldung ab:
    #   can't read "FontsAttrs(,specialencoding)": no such element in array
    # getStringWidth und drawTextBox sagen an derselben Stelle
    # "no font set" -- addForm jetzt auch.
    set p [::pdf4tcl::new %AUTO%]
    $p startPage
    catch {$p addForm text 50 700 100 20 -id f1 -init "Wert"} e
    $p destroy
    set e
} -result {no font set}

test form-font-1.2 {ohne Wert braucht ein Feld keine Schrift} -body {
    # Gegenprobe zur Sperre, und sie hat die erste Fassung korrigiert:
    # ich hatte die Pruefung an den Kopf von addForm gesetzt. Damit
    # fielen sieben Tests der Suite -- addform-tooltip, addform-tabindex,
    # tabsr-1.1, embedfile-6.2 --, die absichtlich Felder ohne Schrift
    # anlegen. Ein Feld ohne Wert baut keinen Strom und braucht keine.
    set p [::pdf4tcl::new %AUTO%]
    $p startPage
    set rc [catch {$p addForm text 50 700 100 20 -id f2} e]
    $p destroy
    set rc
} -result 0

test form-font-1.3 {mit Schrift laeuft es weiter durch} -body {
    # Gegenprobe zur Sperre: sie darf nicht mehr verbieten als gemeint.
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id f3 -init "Wert"
    set data [$p get]
    $p destroy
    regexp {/T \(f3\)} $data
} -result 1

# ---------------------------------------------------------------------------
# 0.9.4.63: auch ein LEERES Feld bekommt ein /AP
# ---------------------------------------------------------------------------

test form-ap-empty-1.1 {ein Feld ohne Wert hat ein Aussehen-Dictionary} -body {
    # Vorher entstand keins. Das ist der Normalfall fuer ein Formular,
    # das spaeter gefuellt wird -- und genau dort erbt ein fillForms
    # nichts, was es aktualisieren koennte.
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id leer
    set data [$p get]
    $p destroy
    regexp {/AP << /N [0-9]+ 0 R >>} $data
} -result 1

test form-ap-empty-1.2 {der Strom ist leer, nicht irgendetwas} -body {
    # Laenge 0, so wie PDF/A es hier schon immer geschrieben hat --
    # ISO 19005 6.3.3 verlangt das Dictionary, nicht seinen Inhalt.
    # Ein "/Tx BMC EMC" waere ein zweiter, neuer Fall gewesen.
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id leer
    set data [$p get]
    $p destroy
    set idx [string first "/Subtype /Form" $data]
    regexp {/Length ([0-9]+)} [string range $data $idx [expr {$idx+200}]] -> len
    set len
} -result 0

test form-ap-empty-1.3 {ein Feld MIT Wert zeichnet weiterhin} -body {
    # Gegenprobe: der leere Strom darf den gefuellten nicht verdraengen.
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id voll -init "Wert"
    set data [$p get]
    $p destroy
    regexp {\(Wert\) Tj} $data
} -result 1

test form-ap-empty-1.4 {ein leeres Feld braucht keine Schrift} -body {
    # Die Schriftpruefung aus form-font-1.1 darf hier NICHT greifen: der
    # leere Strom zeichnet nichts. Die Schrift des Feldes steht in /DA.
    set p [::pdf4tcl::new %AUTO%]
    $p startPage
    set rc [catch {$p addForm text 50 700 100 20 -id leer} e]
    $p destroy
    set rc
} -result 0

test form-font-1.5 {alle acht Feldtypen melden dasselbe} -body {
    # Der Waechter stand zuerst NUR in _BuildTextAP, und die Doku
    # behauptete danach, addForm melde "no font set". Gemessen, indem
    # alle acht Typen ohne setFont durchprobiert wurden: combobox,
    # listbox, pushbutton und signature lieferten weiter die interne
    # Array-Meldung. Vier Bauer, vier Stellen.
    set ergebnis {}
    foreach {t extra} {text {} password {} checkbutton {} \
            radiobutton {-group g -value v} combobox {-options {a b}} \
            listbox {-options {a b}} pushbutton {-caption OK} signature {}} {
        set p [::pdf4tcl::new %AUTO%]
        $p startPage
        set rc [catch {$p addForm $t 50 700 100 20 -id f {*}$extra} e]
        $p destroy
        if {$rc && $e ne "no font set"} { lappend ergebnis $t:$e }
    }
    set ergebnis
} -result {}

test form-font-1.6 {wer keinen Strom baut, braucht keine Schrift} -body {
    # Gegenprobe: die vier Typen ohne Appearance duerfen NICHT sperren.
    # text und password bauen erst mit -init, checkbutton und
    # radiobutton zeichnen mit Vektoren.
    set laufen {}
    foreach {t extra} {text {} password {} checkbutton {} \
            radiobutton {-group g -value v}} {
        set p [::pdf4tcl::new %AUTO%]
        $p startPage
        if {![catch {$p addForm $t 50 700 100 20 -id f {*}$extra}]} {
            lappend laufen $t
        }
        $p destroy
    }
    set laufen
} -result {text password checkbutton radiobutton}

# ---------------------------------------------------------------------------
# 0.9.4.63: /MaxLen, Comb und -format date/time
# ---------------------------------------------------------------------------

test form-maxlen-1.1 {-maxlen schreibt /MaxLen} -body {
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage ; $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id kfz -maxlen 8
    set data [$p get] ; $p destroy
    regexp {/MaxLen 8} $data
} -result 1

test form-maxlen-1.2 {-comb setzt Bit 25 und braucht /MaxLen} -body {
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage ; $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id kfz -maxlen 8 -comb 1
    set data [$p get] ; $p destroy
    # Bit 25 = 16777216 (ISO 32000-1 12.7.4.3, Tabelle 228)
    regexp {/Ff (\d+)} $data -> ff
    expr {$ff & 16777216 ? 1 : 0}
} -result 1

test form-maxlen-1.3 {Comb ohne MaxLen wird gemeldet} -body {
    # Die Norm teilt die Feldbreite durch /MaxLen. Ohne Teiler gibt es
    # keine Kaestchen -- ein Comb-Flag allein taete still nichts.
    set p [::pdf4tcl::new %AUTO%]
    $p startPage ; $p setFont 10 Helvetica
    catch {$p addForm text 50 700 100 20 -id x -comb 1} e
    $p destroy
    string match "*-comb needs -maxlen*" $e
} -result 1

test form-maxlen-1.4 {Comb und multiline schliessen sich aus} -body {
    set p [::pdf4tcl::new %AUTO%]
    $p startPage ; $p setFont 10 Helvetica
    catch {$p addForm text 50 700 100 20 -id x -maxlen 5 -comb 1 -multiline 1} e
    $p destroy
    string match "*exclude each other*" $e
} -result 1

test form-maxlen-1.5 {MaxLen nur bei Textfeldern} -body {
    set p [::pdf4tcl::new %AUTO%]
    $p startPage ; $p setFont 10 Helvetica
    catch {$p addForm combobox 50 700 100 20 -id x -options {a b} -maxlen 5} e
    $p destroy
    string match "*only valid for text and password*" $e
} -result 1

test form-maxlen-1.6 {jedes Zeichen sitzt mittig in seiner Zelle} -body {
    # Der Appearance-Strom setzt je Zeichen eine eigene Textmatrix. Die
    # Abstaende muessen der Zellbreite entsprechen -- 200/8 = 25 pt --
    # und nicht der Zeichenbreite.
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage ; $p setFont 10 Helvetica
    $p addForm text 50 700 200 20 -id kfz -maxlen 8 -comb 1 -init "ABCDEFGH"
    set data [$p get] ; $p destroy
    set xs {}
    foreach {all x} [regexp -all -inline {1 0 0 1 ([0-9.]+) 1.1 Tm} $data] {
        lappend xs $x
    }
    # Acht Zeichen, und der Schritt ist die Zellbreite.
    set schritt [expr {[lindex $xs 1] - [lindex $xs 0]}]
    list [llength $xs] [expr {abs($schritt - 25.0) < 0.5}]
} -result {8 1}

test form-maxlen-1.7 {ohne Comb bleibt es eine Zeile} -body {
    # Gegenprobe: die Zellenrechnung darf nur den Comb-Fall treffen.
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage ; $p setFont 10 Helvetica
    $p addForm text 50 700 200 20 -id normal -init "ABCDEFGH"
    set data [$p get] ; $p destroy
    list [regexp {\(ABCDEFGH\) Tj} $data] \
            [llength [regexp -all -inline {1 0 0 1 [0-9.]+ 1.1 Tm} $data]]
} -result {1 0}

test form-format-1.1 {-format date, Vorgabe deutsch} -body {
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage ; $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id d -format date
    set data [$p get] ; $p destroy
    list [regexp {AFDate_FormatEx} $data] [regexp {dd\.mm\.yyyy} $data]
} -result {1 1}

test form-format-1.2 {benannte Muster und eigene} -body {
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage ; $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id a -format {date format iso}
    $p addForm text 50 660 100 20 -id b -format {date format {dd mmm yyyy}}
    $p addForm text 50 620 100 20 -id c -format {time}
    set data [$p get] ; $p destroy
    list [regexp {yyyy-mm-dd} $data] [regexp {dd mmm yyyy} $data] \
            [regexp {AFTime_FormatEx} $data]
} -result {1 1 1}

test form-format-1.3 {das Zahlenformat bleibt, wie es war} -body {
    # Gegenprobe: date und time duerfen den vorhandenen Weg nicht stoeren.
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage ; $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id n -format {number decimals 2 sep german}
    set data [$p get] ; $p destroy
    regexp {AFNumber_Format\\\(2, 2, 0, 0} $data
} -result 1

test form-format-1.4 {eine unbekannte Art wird gemeldet} -body {
    set p [::pdf4tcl::new %AUTO%]
    $p startPage ; $p setFont 10 Helvetica
    catch {$p addForm text 50 700 100 20 -id x -format {waehrung}} e
    $p destroy
    string match "*must be number, date or time*" $e
} -result 1

test form-format-1.5 {ein unbekannter Schluessel wird gemeldet} -body {
    set p [::pdf4tcl::new %AUTO%]
    $p startPage ; $p setFont 10 Helvetica
    catch {$p addForm text 50 700 100 20 -id x -format {date muster iso}} e
    $p destroy
    string match "*unknown key*" $e
} -result 1

test form-getforms-1.1 {getForms meldet maxlen und comb} -body {
    # Was addForm schreiben kann, muss getForms lesen koennen. Beides kam
    # in .63 dazu, und beim Zuruecklesen fiel es zuerst unter den Tisch.
    set f [file join [temporaryDirectory] gf-[pid].pdf]
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage ; $p setFont 10 Helvetica
    $p addForm text 50 700 200 20 -id kfz -maxlen 8 -comb 1 -init "ABCDEFGH"
    $p addForm text 50 660 200 20 -id name -init "Muster"
    $p addForm text 50 620 200 20 -id kurz -maxlen 5
    $p write -file $f
    $p destroy
    set g [::pdf4tcl::getForms $f]
    file delete $f
    list [dict get $g kfz maxlen] [dict get $g kfz comb] \
         [dict get $g name maxlen] [dict get $g name comb] \
         [dict get $g kurz maxlen] [dict get $g kurz comb]
} -result {8 1 {} 0 5 0}

tcltest::testConstraint haveQpdf [expr {![catch {exec qpdf --version}]}]

# Ein Formular mit /Opt in der PAAR-Form -- pdf4tcl kann sie nicht
# erzeugen, fremde Formulare tragen sie. Von Hand gebaut.
set ::optPaare [file join [file dirname [file normalize [info script]]] \
        fixtures form-opt-paare.pdf]
tcltest::testConstraint haveOptPaare [file readable $::optPaare]

# Ein Formular mit Comb-Bit, aber OHNE /MaxLen -- so etwas kommt in
# fremden Dateien vor, und pdf4tcl erzeugt es nicht: addForm verlangt
# -maxlen zusammen mit -comb. Von Hand gebaut.
set ::combNoMax [file join [file dirname [file normalize [info script]]] \
        fixtures form-comb-nomaxlen.pdf]
tcltest::testConstraint haveCombNoMax [file readable $::combNoMax]

test form-getforms-1.2 {Comb-Bit ohne MaxLen ist kein Kammfeld} -constraints haveQpdf -body {
    # Die Auskunft soll sagen, was die Datei BEWIRKT, nicht was in ihr
    # steht. Ohne Teiler gibt es keine Zellen (ISO 32000-1 12.7.4.3).
    # addForm laesst das gar nicht zu -- eine fremde Datei kann es
    # trotzdem enthalten.
    #
    # Darum eine ECHTE Datei und /MaxLen herausgeschnitten, statt eine
    # von Hand zu bauen: der erste Versuch scheiterte an der fehlenden
    # xref ("no startxref at the end"). qpdf baut sie hinterher neu.
    set f  [file join [temporaryDirectory] gf2-[pid].pdf]
    set f2 [file join [temporaryDirectory] gf3-[pid].pdf]
    set f3 [file join [temporaryDirectory] gf4-[pid].pdf]
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage ; $p setFont 10 Helvetica
    $p addForm text 50 700 200 20 -id x -maxlen 8 -comb 1
    $p write -file $f
    $p destroy
    exec qpdf --qdf --object-streams=disable $f $f2
    set fh [open $f2 rb] ; set d [read $fh] ; close $fh
    # Gleiche Laenge, damit nichts verrutscht -- qpdf richtet die xref
    # danach ohnehin neu ein.
    set d [string map {"/MaxLen 8" "/Xaxlen 8"} $d]
    set fh [open $f2 wb] ; puts -nonewline $fh $d ; close $fh
    exec qpdf $f2 $f3
    set g [::pdf4tcl::getForms $f3]
    file delete $f $f2 $f3
    list [expr {[dict get $g x flags] & 16777216 ? 1 : 0}] \
            [dict get $g x comb] [dict get $g x maxlen]
} -result {1 0 {}}

test form-maxlen-1.8 {die Ausrichtung waehlt die Zellen} -body {
    # Vorher begann der Text immer bei Zelle 0, und -align war eine
    # Option, die es gibt und die nichts tut: /Q stand in der Datei und
    # wirkte nicht. Drei Zeichen in acht Zellen, 200 pt breit -- also
    # 25 pt je Zelle.
    set erste {}
    foreach a {left center right} {
        set p [::pdf4tcl::new %AUTO% -compress 0]
        $p startPage ; $p setFont 10 Helvetica
        $p addForm text 50 700 200 20 -id f -maxlen 8 -comb 1 \
                -align $a -init "ABC"
        set data [$p get] ; $p destroy
        regexp {1 0 0 1 ([0-9.]+) 1.1 Tm} $data -> x
        lappend erste $x
    }
    lassign $erste l c r
    # links Zelle 0, mittig Zelle 2 ((8-3)/2), rechts Zelle 5 (8-3).
    list [expr {abs($c - $l - 50.0) < 0.5}] [expr {abs($r - $l - 125.0) < 0.5}]
} -result {1 1}

test form-maxlen-1.9 {ein zu langer -init wird gemeldet} -body {
    # Gemessen: acht Zeichen bei -maxlen 4 liefen durch, der Comb-Strom
    # zeichnete vier, die anderen verschwanden still -- und /V trug
    # trotzdem alle acht. Die Datei haette etwas enthalten, das niemand
    # sieht und niemand tippen koennte.
    set p [::pdf4tcl::new %AUTO%]
    $p startPage ; $p setFont 10 Helvetica
    catch {$p addForm text 50 700 200 20 -id f -maxlen 4 -init "ABCDEFGH"} e
    $p destroy
    set e
} -result {-init is longer than -maxlen (8 > 4)}

test form-maxlen-1.10 {gleich lang ist erlaubt} -body {
    # Gegenprobe zur Grenze: sie darf nicht eins zu frueh greifen.
    set p [::pdf4tcl::new %AUTO%]
    $p startPage ; $p setFont 10 Helvetica
    set rc [catch {$p addForm text 50 700 200 20 -id f -maxlen 8 -init "ABCDEFGH"}]
    $p destroy
    set rc
} -result 0

test form-zadb-1.1 {ZaDb bekommt eine ToUnicode-Zuordnung} -body {
    # WARUM: ohne sie meldete pdfcheck-native
    #   "ZapfDingbats: no ToUnicode map -- text cannot be extracted"
    # -- gemessen ueber demo/out, sechs Dateien, alle mit Formularen.
    # ZapfDingbats kommt nur ueber Ankreuz- und Optionsfelder herein,
    # und zwar nur bei -markstyle font/auto ohne -pdfa; mit Vektormarke
    # entsteht die Schrift gar nicht.
    set p [pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm checkbutton 50 50 15 15 -id haken
    $p endPage
    set d [$p get]
    $p destroy
    set i [string first "/BaseFont /ZapfDingbats" $d]
    list [expr {$i >= 0}] \
         [expr {[string first "/ToUnicode" [string range $d $i end]] >= 0}]
} -result {1 1}

test form-zadb-1.2 {die Zuordnung nennt Haken und Punkt} -body {
    # Nicht nur DASS eine Zuordnung da ist, sondern WELCHE. Eine leere
    # oder falsche CMap wuerde den Test oben bestehen und trotzdem
    # nichts taugen.
    #   (4) = 0x34  Haken   -> U+2714
    #   (l) = 0x6C  Punkt   -> U+25CF
    set p [pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm checkbutton 50 50 15 15 -id haken
    $p endPage
    set d [$p get]
    $p destroy
    set i [string first "/Registry (ZapfDingbats)" $d]
    set rest [string range $d $i end]
    list [expr {[string first "<34> <2714>" $rest] >= 0}] \
         [expr {[string first "<6C> <25CF>" $rest] >= 0}]
} -result {1 1}

test form-zadb-1.3 {das Dokument bleibt lesbar} -body {
    # DER WICHTIGE TEST. Der erste Einbau uebergab MakeStream ein
    # fertiges "<<\n>>", und MakeStream haengt /Length und ">>" selbst
    # an -- es entstand ein ">>" zuviel, die Datei war kaputt, und JEDER
    # Leser lief sich darin fest: getForms haengte, auch die Fassung .63
    # an einer .64-Datei.
    #
    # Kein bestehender Test hat das gefangen, weil keiner getForms auf
    # ein Dokument MIT Ankreuzfeld anwendet. Genau das tut dieser.
    set f [makeFile {} zadb-lesbar.pdf]
    set p [pdf4tcl::new %AUTO%]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 100 200 20 -id name
    $p addForm checkbutton 50 50 15 15 -id haken
    $p write -file $f
    $p destroy
    set n [dict size [pdf4tcl::getForms $f]]
    removeFile zadb-lesbar.pdf
    set n
} -result 2


test form-fillap-1.1 {fillForms zieht den Appearance-Strom mit} -body {
    # DIE LUECKE, die fillForms bis .63 hatte: es setzte /V und
    # /NeedAppearances, liess den Strom aber, wie er war. Ein Betrachter,
    # der die Flagge befolgt, zeigte den neuen Wert; eine Druckstrecke,
    # die den Strom zeichnet, den ALTEN -- bei einem leeren Feld also
    # nichts. Auf Papier stand etwas anderes als in der Datei, und man
    # sah es dem Bildschirm nicht an.
    #
    # .63 hat vorgesorgt: seither bekommt auch ein leeres Feld einen
    # (leeren) Strom, damit es hier etwas zum Ueberschreiben gibt.
    set leer [makeFile {} fillap-leer.pdf]
    set voll [makeFile {} fillap-voll.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 80 68 150 16 -id kunde
    $p write -file $leer
    $p destroy
    pdf4tcl::fillForms $leer $voll {kunde "Spedition Muster"}
    set fh [open $voll rb] ; set d [read $fh] ; close $fh
    removeFile fillap-leer.pdf
    removeFile fillap-voll.pdf
    # Der Wert muss GEZEICHNET werden, nicht nur in /V stehen.
    list [expr {[string first "(Spedition Muster) Tj" $d] >= 0}] \
         [expr {[string first "/NeedAppearances" $d] >= 0}]
} -result {1 1}

test form-fillap-1.2 {der Strom ersetzt den alten, er kommt nicht dazu} -body {
    # Ueberschreiben statt anhaengen: .63 legt den leeren Strom an, und
    # genau dieses Objekt wird neu geschrieben. Ein zweites Objekt waere
    # Muell in der Datei, auf das niemand zeigt.
    set leer [makeFile {} fillap2-leer.pdf]
    set voll [makeFile {} fillap2-voll.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 80 68 150 16 -id kunde
    $p write -file $leer
    $p destroy
    pdf4tcl::fillForms $leer $voll {kunde "Muster"}
    set fh [open $leer rb] ; set a [read $fh] ; close $fh
    set fh [open $voll rb] ; set b [read $fh] ; close $fh
    set na [regexp -all {/Subtype /Form} $a]
    set nb [regexp -all {/Subtype /Form} $b]
    removeFile fillap2-leer.pdf
    removeFile fillap2-voll.pdf
    expr {$na == $nb}
} -result 1

test form-fillap-1.3 {ein Comb-Feld bleibt unangetastet} -body {
    # Die Zellenbreite haengt an /MaxLen, und ein halb gezeichnetes
    # Comb-Feld waere schlechter als ein ungezeichnetes. Der alte Strom
    # bleibt also stehen -- wie bisher, und das ist hier die richtige
    # Antwort.
    set leer [makeFile {} fillap3-leer.pdf]
    set voll [makeFile {} fillap3-voll.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 30 40 150 16 -id kfz -maxlen 8 -comb 1
    $p write -file $leer
    $p destroy
    pdf4tcl::fillForms $leer $voll {kfz "AB123456"}
    set fh [open $voll rb] ; set d [read $fh] ; close $fh
    removeFile fillap3-leer.pdf
    removeFile fillap3-voll.pdf
    # Der Wert steht in /V, aber NICHT als fortlaufender Text im Strom.
    list [expr {[string first "(AB123456)" $d] >= 0}] \
         [expr {[string first "(AB123456) Tj" $d] >= 0}]
} -result {1 0}


test form-fillap-1.4 {ein Kennwortfeld bekommt KEINEN neuen Strom} -body {
    # Gefunden ueber demo-forms-tk.tcl, nicht ueber einen Test: der
    # Rundlauf der Demo zeigte "pw_empty ... gezeichnet ja", und im
    # Strom stand "(Muster pw_empty) Tj" -- das Kennwort im KLARTEXT,
    # waehrend der Bildschirm Punkte zeigt.
    #
    # Punkte statt Klartext zu zeichnen waere die andere Moeglichkeit,
    # aber sie ist schlechter: der Wert steht ohnehin in /V, und ein
    # gezeichneter Punktestrom taeuschte vor, die Datei gaebe das
    # Kennwort nicht preis.
    set leer [makeFile {} pw-leer.pdf]
    set voll [makeFile {} pw-voll.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm password 30 40 150 16 -id geheim
    $p write -file $leer
    $p destroy
    pdf4tcl::fillForms $leer $voll {geheim "Sesam"}
    set fh [open $voll rb] ; set d [read $fh] ; close $fh
    removeFile pw-leer.pdf
    removeFile pw-voll.pdf
    # In /V steht er -- das ist die Aufgabe von fillForms. Im STROM nicht.
    list [expr {[string first "/V (Sesam)" $d] >= 0}] \
         [expr {[string first "(Sesam) Tj" $d] >= 0}]
} -result {1 0}


test form-multi-1.1 {addForm bricht ein mehrzeiliges Feld um} -body {
    # Bis 0.9.4.63 stand der ganze Text in EINER Zeile -- mitsamt dem
    # "\n" als sichtbarem Zeichen im Textstring, das kein Betrachter
    # umbricht. Ein langer Text lief aus dem Kasten.
    set p [pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 30 40 150 50 -id ml -multiline 1 \
            -init "Erste Zeile\nZweite Zeile"
    $p endPage
    set d [$p get]
    $p destroy
    list [expr {[string first "(Erste Zeile) Tj" $d] >= 0}] \
         [expr {[string first "(Zweite Zeile) Tj" $d] >= 0}]
} -result {1 1}

test form-multi-1.2 {ein langer Text bricht von selbst um} -body {
    # Wer nur an "\n" bricht, laesst lange Zeilen aus dem Kasten laufen.
    # Der Umbruch misst mit derselben Schrift und Groesse, die auch der
    # Strom setzt -- eine geschaetzte Breite waere eine zweite Rechnung.
    set p [pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 30 40 100 50 -id ml -multiline 1 \
            -init "Ein recht langer Text ohne Umbruchzeichen der von selbst umbrechen muesste"
    $p endPage
    set d [$p get]
    $p destroy
    # Mehr als eine Zeile heisst: mehr als ein Tj im Strom.
    regexp {/Tx BMC BT.*?ET EMC} $d strom
    expr {[regexp -all {\) Tj} $strom] > 1}
} -result 1

test form-multi-1.3 {einzeilig bleibt einzeilig} -body {
    # Die Gegenprobe: ohne -multiline darf sich nichts aendern, sonst
    # misst der Test oben nur, dass ueberhaupt etwas gezeichnet wird.
    set p [pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 30 40 150 16 -id einz -init "Nur eine Zeile"
    $p endPage
    set d [$p get]
    $p destroy
    regexp {/Tx BMC BT.*?ET EMC} $d strom
    list [regexp -all {\) Tj} $strom] \
         [expr {[string first "2 1.1 Td" $strom] >= 0}]
} -result {1 1}

test form-multi-1.4 {fillForms bricht ebenso um} -body {
    # DIESELBE Routine wie beim Erzeugen. Zwei Umbruchrechnungen fuer
    # dieselbe Sache gingen auseinander, und dann saehe dasselbe Feld je
    # nachdem verschieden aus.
    set leer [makeFile {} ml-leer.pdf]
    set voll [makeFile {} ml-voll.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 30 40 150 50 -id ml -multiline 1
    $p write -file $leer
    $p destroy
    pdf4tcl::fillForms $leer $voll \
            {ml "Spedition Muster GmbH\nHauptstrasse 1\n48691 Vreden"}
    set fh [open $voll rb] ; set d [read $fh] ; close $fh
    removeFile ml-leer.pdf
    removeFile ml-voll.pdf
    list [expr {[string first "(Spedition Muster GmbH) Tj" $d] >= 0}] \
         [expr {[string first "(48691 Vreden) Tj" $d] >= 0}]
} -result {1 1}

test form-multi-1.5 {ein zu breites Wort wird nicht getrennt} -body {
    # Mitten im Wort zu trennen waere eine Silbentrennung, und die ist
    # ohne Woerterbuch geraten. Es bleibt ganz und ragt lieber heraus --
    # der BBox schneidet es ab, und das sieht man.
    set breite [list apply {{s} {expr {[string length $s] * 5.0}}}]
    pdf4tcl::FormWrapLines "kurz Donaudampfschiffahrtsgesellschaft x" 40 $breite
} -result {kurz Donaudampfschiffahrtsgesellschaft x}


test form-comb-1.1 {fillForms zeichnet ein Comb-Feld in Zellen} -body {
    # Die Feldbreite durch /MaxLen geteilt, jedes Zeichen MITTIG in
    # seiner Zelle (ISO 32000-1 12.7.4.3, Tabelle 228, Bit 25). Ein
    # Kennzeichen steht so ueber den vorgedruckten Kaestchen und nicht
    # daneben. Dasselbe, was addForm beim Erzeugen tut.
    set leer [makeFile {} comb-leer.pdf]
    set voll [makeFile {} comb-voll.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5 -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 30 40 160 20 -id kfz -maxlen 8 -comb 1
    $p write -file $leer
    $p destroy
    pdf4tcl::fillForms $leer $voll {kfz "BOR-AB12"}
    set fh [open $voll rb] ; set d [read $fh] ; close $fh
    removeFile comb-leer.pdf
    removeFile comb-voll.pdf
    regexp {/Tx BMC BT.*?ET EMC} $d strom
    # Acht Zeichen, also acht Tj -- eines je Zelle, nicht eine
    # Zeichenkette am Stueck.
    list [regexp -all {\) Tj} $strom] \
         [expr {[string first "(B) Tj" $strom] >= 0}]
} -result {8 1}

test form-comb-1.2 {ohne /MaxLen bleibt der alte Strom stehen} \
        -constraints haveCombNoMax -body {
    # Ein Formular darf Bit 25 tragen, ohne /MaxLen zu setzen. Dann gibt
    # es keinen Teiler und keine Zellen -- und ein halb gezeichnetes
    # Comb-Feld waere schlechter als ein ungezeichnetes.
    #
    # Die Bedingung ist MESSBAR und nicht geraten: /MaxLen ist da oder
    # nicht. /V wird trotzdem gesetzt, das ist die Aufgabe von
    # fillForms.
    set aus [makeFile {} combno-voll.pdf]
    pdf4tcl::fillForms $::combNoMax $aus {kfz "AB12"}
    set fh [open $aus rb] ; set d [read $fh] ; close $fh
    removeFile combno-voll.pdf
    # Der alte Strom steht komprimiert in der Datei -- also entpacken
    # statt im Klartext zu suchen. Mein erster Anlauf tat das nicht und
    # meldete "alter Strom weg", obwohl er dastand: ein Messfehler, kein
    # Befund.
    set altDa 0
    foreach m [regexp -all -inline "stream\n(.*?)endstream" $d] {
        if {[catch {zlib decompress [string trimright $m "\n"]} t]} continue
        if {[string first "(alt) Tj" $t] >= 0} { set altDa 1 }
    }
    list [expr {[string first "/V (AB12)" $d] >= 0}] $altDa
} -result {1 1}


test form-choice-1.1 {ein Auswahlfeld behaelt seinen Kasten} -body {
    # DER RUECKSCHRITT, den das Strombauen selbst eingebaut hatte: bis
    # hierher pruefte fillForms nur die FLAGGEN und nicht den Feldtyp.
    # Ein Listenfeld lief als Textfeld durch, und der neue Strom warf
    # weissen Kasten und Rahmen weg:
    #
    #   vorher:  /Tx BMC 1 1 1 rg 0 0 150 40 re f ... (Bremen) Tj
    #   nachher: /Tx BMC BT ... (Vreden) Tj
    #
    # Der Wert war richtig und das Feld sah aus wie nichts.
    set leer [makeFile {} ch-leer.pdf]
    set voll [makeFile {} ch-voll.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5 -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm listbox 30 40 150 40 -id lb \
            -options {Bremen Hamburg Vreden} -init Bremen
    $p write -file $leer
    $p destroy
    pdf4tcl::fillForms $leer $voll {lb Vreden}
    set fh [open $voll rb] ; set d [read $fh] ; close $fh
    removeFile ch-leer.pdf
    removeFile ch-voll.pdf
    # /V neu, Strom unveraendert -- die dokumentierte Grenze.
    list [expr {[string first "/V (Vreden)" $d] >= 0}] \
         [expr {[string first "0 0 150 40 re f" $d] >= 0}] \
         [expr {[string first "(Bremen) Tj" $d] >= 0}]
} -result {1 1 1}


test form-opt-1.1 {getForms nennt Erklaerung und Auswahlwerte} -body {
    # pdf4tcl SCHRIEB beides schon -- -tooltip wird zu /TU, -options zu
    # /Opt -- und getForms gab keines von beiden wieder heraus. Ein
    # Paket, das eine Auskunft schreibt und nicht liest, zwingt den
    # Aufrufer, die Datei selbst aufzumachen.
    #
    # Aufgefallen ueber tclpdfium: dort hatte ich beide Auskuenfte am
    # 06.09.2026 ergaenzt, und beim Vergleich fehlten sie hier.
    set f [makeFile {} opt-a.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 30 40 150 16 -id kunde -tooltip "Empfaenger und Anschrift"
    $p addForm combobox 30 70 150 16 -id artikel -options {Alpha Beta} -init Alpha
    $p write -file $f
    $p destroy
    set d [pdf4tcl::getForms $f]
    removeFile opt-a.pdf
    list [dict get $d kunde description] \
         [dict get $d kunde options] \
         [dict get $d artikel options]
} -result {{Empfaenger und Anschrift} {} {{Alpha Alpha} {Beta Beta}}}

test form-opt-1.2 {fillForms lehnt einen Wert ab, den es nicht gibt} -body {
    # Bis 0.9.4.64 wurde JEDER Wert in /V geschrieben und ein Erfolg
    # gemeldet. Das Feld traegt damit einen ungueltigen Zustand, und ein
    # Betrachter zeigt je nach Laune nichts oder den alten Eintrag --
    # ein stiller Falscherfolg.
    set leer [makeFile {} opt-b.pdf]
    set voll [makeFile {} opt-c.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm combobox 30 70 150 16 -id artikel -options {Alpha Beta} -init Alpha
    $p write -file $leer
    $p destroy
    set gut [catch {pdf4tcl::fillForms $leer $voll {artikel Beta}}]
    catch {pdf4tcl::fillForms $leer $voll {artikel "Gibt es nicht"}} e
    removeFile opt-b.pdf
    removeFile opt-c.pdf
    list $gut [string match "*is not an option*" $e] \
         [string match "*Alpha Beta*" $e]
} -result {0 1 1}

test form-opt-1.3 {Exportwert UND Beschriftung werden angenommen} \
        -constraints haveOptPaare -body {
    # /Opt darf auch Paare tragen: [[(DE) (Deutschland)] ...]. pdf4tcl
    # schreibt diese Form nicht, LIEST aber fremde Formulare -- und dort
    # kommt sie vor.
    #
    # Geprueft wird gegen BEIDE Spalten: ein Aufrufer kann den
    # Exportwert oder die Beschriftung meinen. Wer nur eine nimmt, lehnt
    # die Haelfte der gueltigen Werte ab.
    #
    # Ausserdem faengt dieser Test ein grobes Muster ab: wer /Opt mit
    # [^\]]* liest, bricht an der ersten inneren Klammer und haelt drei
    # Eintraege fuer sechs.
    set aus [makeFile {} opt-d.pdf]
    set opts [dict get [pdf4tcl::getForms $::optPaare] land options]
    set a [catch {pdf4tcl::fillForms $::optPaare $aus {land DE}}]
    set b [catch {pdf4tcl::fillForms $::optPaare $aus {land Niederlande}}]
    set c [catch {pdf4tcl::fillForms $::optPaare $aus {land Frankreich}}]
    removeFile opt-d.pdf
    list [llength $opts] [lindex [lindex $opts 0] 0] $a $b $c
} -result {3 DE 0 0 1}


test form-opt-1.4 {ein LEERER Wert ist erlaubt} -body {
    # "nichts gewaehlt" ist ein gueltiger Zustand, und /V () steht so in
    # jedem frisch erzeugten Auswahlfeld.
    #
    # Meine erste Fassung der Pruefung lehnte ihn ab -- damit brach der
    # Rundlauf in demo/demo-forms.tcl, der ALLE Felder ausliest und
    # zurueckschreibt, das leere Auswahlfeld eingeschlossen. Gemeldet
    # 07.09.2026, gefunden hat es die Demo und kein Test.
    #
    # Eine Pruefung, die einen gueltigen Zustand verbietet, ist
    # schlimmer als keine: sie bricht Arbeitsablaeufe, die vorher
    # liefen.
    set leer [makeFile {} opt-e.pdf]
    set voll [makeFile {} opt-f.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm combobox 30 40 150 16 -id a -options {Alpha Beta}
    $p write -file $leer
    $p destroy
    set rc [catch {pdf4tcl::fillForms $leer $voll [list a ""]}]
    removeFile opt-e.pdf
    removeFile opt-f.pdf
    set rc
} -result 0

test form-opt-1.5 {der Rundlauf ueber ALLE Felder laeuft durch} -body {
    # Genau das tut die Demo: getForms lesen, jeden Wert
    # zurueckschreiben. Eine Pruefung darf daran nicht scheitern --
    # sonst bricht sie den haeufigsten Gebrauch der Schnittstelle.
    set leer [makeFile {} opt-g.pdf]
    set voll [makeFile {} opt-h.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 30 20 150 16 -id t
    $p addForm combobox 30 50 150 16 -id c -options {Alpha Beta}
    $p addForm checkbutton 30 80 15 15 -id h
    $p write -file $leer
    $p destroy
    set werte {}
    dict for {id info} [pdf4tcl::getForms $leer] {
        if {[dict get $info type] eq "/Btn"} continue
        dict set werte $id [dict get $info value]
    }
    set rc [catch {pdf4tcl::fillForms $leer $voll $werte} e]
    removeFile opt-g.pdf
    removeFile opt-h.pdf
    list $rc $e
} -result {0 2}


::tcltest::cleanupTests
