# cat-acroform.test -- catPdf: die interaktive Form zusammenfuehren
#
# Bis 0.9.4.44 war das ein Rumpf: AppendPdf las beide Woerterbuecher und
# endete im Kommentar "How to do this???". Der Wurzelkatalog behielt die
# /AcroForm des ERSTEN Dokuments, das Feld des zweiten sass fertig
# gezeichnet auf seiner Seite, und kein Leser bot es zum Ausfuellen an.
# Gemessen mit pdftk: ein Feld, wo zwei hineingegangen waren. Gewarnt hat
# nichts.

source [file join [file dirname [file join [pwd] [info script]]] init.tcl]

# Ein Dokument mit einem Textfeld je Seite.
tcltest::testConstraint haveQpdf [expr {![catch {exec qpdf --version}]}]
tcltest::testConstraint haveVerapdf [expr {![catch {exec verapdf --version}]}]

proc catFormDoc {file id {title {}}} {
    set p [::pdf4tcl::new %AUTO% -compress 0 -paper a4 -orient 1]
    if {$title ne ""} { $p metadata -title $title }
    $p startPage
    $p setFont 12 Helvetica
    $p text "Formular $id" -x 60 -y 60
    $p addForm text 60 100 200 20 -id $id
    $p write -file $file
    $p destroy
}

proc catPlainDoc {file text} {
    set p [::pdf4tcl::new %AUTO% -compress 0 -paper a4 -orient 1]
    $p startPage
    $p setFont 12 Helvetica
    $p text $text -x 60 -y 60
    $p write -file $file
    $p destroy
}

# Die /Fields des Wurzelkatalogs -- also das, was ein Leser sieht. Die
# uebrigen /Fields-Arrays im File gehoeren zu den verwaisten Katalogen der
# angehaengten Dokumente und zaehlen nicht.
proc catRootFields {file} {
    set doc [::pdf4tcl::cat::ReadPdf $file]
    set rootId [lindex [dict get $doc trailer /Root] 0]
    set root [::pdf4tcl::cat::PdfObjToTclDict [dict get $doc $rootId full]]
    if {![dict exists $root /AcroForm]} { return {} }
    set acroId [lindex [dict get $root /AcroForm] 0]
    if {![dict exists $doc $acroId]} { return {} }
    set acro [::pdf4tcl::cat::PdfObjToTclDict [dict get $doc $acroId full]]
    if {![dict exists $acro /Fields]} { return {} }
    set out {}
    foreach {full num} [regexp -all -inline {(\d+)\s+\d+\s+R} \
            [dict get $acro /Fields]] {
        lappend out $num
    }
    return $out
}

# Die Feldnamen hinter diesen Referenzen.
proc catFieldNames {file} {
    set doc [::pdf4tcl::cat::ReadPdf $file]
    set out {}
    foreach num [catRootFields $file] {
        if {[dict exists $doc $num]
                && [regexp {/T\s*\(([^)]*)\)} [dict get $doc $num full] -> n]} {
            lappend out $n
        }
    }
    return [lsort $out]
}

# ---------------------------------------------------------------------------
# cat-acroform-1.x  Beide Dokumente haben ein Formular
# ---------------------------------------------------------------------------

test cat-acroform-1.1 {beide Felder stehen im Wurzelkatalog} -body {
    catFormDoc [file join [temporaryDirectory] af1.pdf] feld_1
    catFormDoc [file join [temporaryDirectory] af2.pdf] feld_2
    set out [file join [temporaryDirectory] afout.pdf]
    ::pdf4tcl::catPdf [file join [temporaryDirectory] af1.pdf] \
            [file join [temporaryDirectory] af2.pdf] $out
    catFieldNames $out
} -result {feld_1 feld_2}

test cat-acroform-1.2 {drei Dokumente, drei Felder} -body {
    foreach n {1 2 3} {
        catFormDoc [file join [temporaryDirectory] a3_$n.pdf] "f$n"
    }
    set out [file join [temporaryDirectory] a3out.pdf]
    ::pdf4tcl::catPdf [file join [temporaryDirectory] a3_1.pdf] \
            [file join [temporaryDirectory] a3_2.pdf] \
            [file join [temporaryDirectory] a3_3.pdf] $out
    catFieldNames $out
} -result {f1 f2 f3}

test cat-acroform-1.3 {das Ergebnis ist lesbar} -body {
    set out [file join [temporaryDirectory] afout.pdf]
    # ReadPdf faellt ueber ein kaputtes Dokument her, bevor irgendetwas
    # anderes es tut.
    set doc [::pdf4tcl::cat::ReadPdf $out]
    expr {[dict exists $doc trailer] && [dict get $doc N] > 1}
} -result 1

# ---------------------------------------------------------------------------
# cat-acroform-2.x  Nur eines der Dokumente hat ein Formular
# ---------------------------------------------------------------------------

test cat-acroform-2.1 {Text plus Formular: das Feld ueberlebt} -body {
    catPlainDoc [file join [temporaryDirectory] ap1.pdf] "Nur Text"
    catFormDoc  [file join [temporaryDirectory] ap2.pdf] nur_dieses
    set out [file join [temporaryDirectory] apout1.pdf]
    ::pdf4tcl::catPdf [file join [temporaryDirectory] ap1.pdf] \
            [file join [temporaryDirectory] ap2.pdf] $out
    catFieldNames $out
} -result nur_dieses

test cat-acroform-2.2 {Formular plus Text: das Feld bleibt} -body {
    set out [file join [temporaryDirectory] apout2.pdf]
    ::pdf4tcl::catPdf [file join [temporaryDirectory] ap2.pdf] \
            [file join [temporaryDirectory] ap1.pdf] $out
    catFieldNames $out
} -result nur_dieses

test cat-acroform-2.3 {zwei Dokumente ohne Formular bekommen keines} -body {
    catPlainDoc [file join [temporaryDirectory] ap3.pdf] "Auch nur Text"
    set out [file join [temporaryDirectory] apout3.pdf]
    ::pdf4tcl::catPdf [file join [temporaryDirectory] ap1.pdf] \
            [file join [temporaryDirectory] ap3.pdf] $out
    catRootFields $out
} -result {}

# ---------------------------------------------------------------------------
# cat-acroform-3.x  Gleiche Feldnamen
# ---------------------------------------------------------------------------

test cat-acroform-3.1 {gleiche Namen werden gemeldet} -body {
    # Zwei Felder desselben Namens sind fuer einen Leser EIN Feld mit einem
    # gemeinsamen Wert (ISO 32000-1 12.7.3.2). Das ist manchmal gewollt --
    # deshalb eine Warnung und kein Fehler, und deshalb wird auch nicht
    # umbenannt: ein /T-Verweis in mitgeliefertem JavaScript zeigte danach
    # ins Leere.
    catFormDoc [file join [temporaryDirectory] ad1.pdf] name
    catFormDoc [file join [temporaryDirectory] ad2.pdf] name
    set out [file join [temporaryDirectory] adout.pdf]
    set ::pdf4tcl::warnings {}
    ::pdf4tcl::catPdf [file join [temporaryDirectory] ad1.pdf] \
            [file join [temporaryDirectory] ad2.pdf] $out
    set hit 0
    foreach w $::pdf4tcl::warnings {
        if {[string match "*form field name*shared value*name*" $w]} { set hit 1 }
    }
    return $hit
} -result 1

test cat-acroform-3.2 {beide Verweise bleiben trotzdem stehen} -body {
    set out [file join [temporaryDirectory] adout.pdf]
    llength [catRootFields $out]
} -result 2

test cat-acroform-3.3 {verschiedene Namen erzeugen keine Warnung} -body {
    set out [file join [temporaryDirectory] afout.pdf]
    set ::pdf4tcl::warnings {}
    ::pdf4tcl::catPdf [file join [temporaryDirectory] af1.pdf] \
            [file join [temporaryDirectory] af2.pdf] $out
    set hit 0
    foreach w $::pdf4tcl::warnings {
        if {[string match "*form field name*" $w]} { set hit 1 }
    }
    return $hit
} -result 0

# ---------------------------------------------------------------------------
# cat-acroform-4.x  Was NICHT passieren darf
# ---------------------------------------------------------------------------

test cat-acroform-4.1 {NeedAppearances wird nicht gesetzt} -body {
    # Es beschaedigt digitale Signaturen, und jeder Feldtyp schreibt seinen
    # eigenen Erscheinungsstream.
    set out [file join [temporaryDirectory] afout.pdf]
    set ch [open $out rb]
    set data [read $ch]
    close $ch
    string match "*NeedAppearances*" $data
} -result 0

test cat-acroform-4.2 {die Seitenzahl stimmt weiterhin} -body {
    set out [file join [temporaryDirectory] afout.pdf]
    set doc [::pdf4tcl::cat::ReadPdf $out]
    set rootId [lindex [dict get $doc trailer /Root] 0]
    set root [::pdf4tcl::cat::PdfObjToTclDict [dict get $doc $rootId full]]
    set pagesId [lindex [dict get $root /Pages] 0]
    regexp {/Count\s+(\d+)} [dict get $doc $pagesId full] -> count
    set count
} -result 2

# Die erzeugten Dateien wieder wegraeumen -- tcltest meldet sonst
# "files left behind", und das ist beim naechsten Lauf Rauschen, in dem ein
# echter Befund untergeht.
foreach pat {af*.pdf ap*.pdf ad*.pdf a3*.pdf} {
    foreach f [glob -nocomplain -directory [temporaryDirectory] $pat] {
        file delete $f
    }
}


# ---------------------------------------------------------------------------
# cat-info-x  Die Metadaten des zusammengefuehrten Dokuments
#
# Zusammenfuehren behaelt den Katalog des ERSTEN Dokuments, und damit
# dessen /Info -- zwei Akten ergeben eine, die "Teil 1" heisst. Das ist
# fuer sich nicht falsch: ein Werkzeug kann nicht wissen, wie zwei
# Dokumente zusammen heissen. Ueberraschend ist es nur, wenn es niemand
# sagt. Deshalb fragt catPdf jetzt.
# ---------------------------------------------------------------------------

# Den Titel aus dem /Info-Woerterbuch lesen, nicht den ersten in der
# Datei. Beim Zusammenfuehren bleibt das /Info des zweiten Dokuments als
# verwaistes Objekt liegen -- es steht sogar VOR dem gueltigen, weil
# angehaengt wird. Wer den ersten Treffer nimmt, misst das falsche.
proc catInfoTitle {file} {
    set fh [open $file rb]
    set data [read $fh]
    close $fh
    if {![regexp {/Info\s+(\d+)\s+0\s+R} $data -> id]} { return "" }
    if {![regexp "\n$id\\s+0\\s+obj(.*?)endobj" $data -> body]} { return "" }
    if {[regexp {/Title\s*\(([^)]*)\)} $body -> t]} { return $t }
    return ""
}

test cat-info-1 {ohne Option gewinnt das erste Dokument} -setup {
    catFormDoc [file join [temporaryDirectory] i1.pdf] f1 "Erstes"
    catFormDoc [file join [temporaryDirectory] i2.pdf] f2 "Zweites"
} -body {
    ::pdf4tcl::catPdf [file join [temporaryDirectory] i1.pdf] \
            [file join [temporaryDirectory] i2.pdf] \
            [file join [temporaryDirectory] iout.pdf]
    catInfoTitle [file join [temporaryDirectory] iout.pdf]
} -result Erstes

test cat-info-2 {-title setzt den Titel des Ergebnisses} -setup {
    catFormDoc [file join [temporaryDirectory] i1.pdf] f1 "Erstes"
    catFormDoc [file join [temporaryDirectory] i2.pdf] f2 "Zweites"
} -body {
    ::pdf4tcl::catPdf -title "Gesamtakte" \
            [file join [temporaryDirectory] i1.pdf] \
            [file join [temporaryDirectory] i2.pdf] \
            [file join [temporaryDirectory] iout.pdf]
    catInfoTitle [file join [temporaryDirectory] iout.pdf]
} -result Gesamtakte

test cat-info-3 {ein leerer Wert entfernt den Eintrag} -setup {
    catFormDoc [file join [temporaryDirectory] i1.pdf] f1 "Erstes"
    catFormDoc [file join [temporaryDirectory] i2.pdf] f2 "Zweites"
} -body {
    # Besser kein Titel als der falsche.
    ::pdf4tcl::catPdf -title "" \
            [file join [temporaryDirectory] i1.pdf] \
            [file join [temporaryDirectory] i2.pdf] \
            [file join [temporaryDirectory] iout.pdf]
    catInfoTitle [file join [temporaryDirectory] iout.pdf]
} -result {}

test cat-info-4 {Klammern im Titel werden maskiert} -setup {
    catFormDoc [file join [temporaryDirectory] i1.pdf] f1 "Erstes"
    catFormDoc [file join [temporaryDirectory] i2.pdf] f2 "Zweites"
} -body {
    # Eine unmaskierte Klammer beendet die PDF-Zeichenkette vorzeitig und
    # macht die Datei kaputt.
    ::pdf4tcl::catPdf -title "Akte (2026)" \
            [file join [temporaryDirectory] i1.pdf] \
            [file join [temporaryDirectory] i2.pdf] \
            [file join [temporaryDirectory] iout.pdf]
    set fh [open [file join [temporaryDirectory] iout.pdf] rb]
    set data [read $fh]
    close $fh
    expr {[string match {*/Title (Akte \\(2026\\))*} $data]}
} -result 1

test cat-info-5 {mehrere Angaben zugleich} -setup {
    catFormDoc [file join [temporaryDirectory] i1.pdf] f1 "Erstes"
    catFormDoc [file join [temporaryDirectory] i2.pdf] f2 "Zweites"
} -body {
    ::pdf4tcl::catPdf -title "T" -author "A" -subject "S" \
            [file join [temporaryDirectory] i1.pdf] \
            [file join [temporaryDirectory] i2.pdf] \
            [file join [temporaryDirectory] iout.pdf]
    set fh [open [file join [temporaryDirectory] iout.pdf] rb]
    set data [read $fh]
    close $fh
    list [regexp {/Title \(T\)} $data] [regexp {/Author \(A\)} $data] \
         [regexp {/Subject \(S\)} $data]
} -result {1 1 1}

test cat-info-6 {unbekannte Option wird benannt} -body {
    catch {::pdf4tcl::catPdf -quatsch x a.pdf b.pdf c.pdf} e
    expr {[string match {*unknown option*-quatsch*} $e]}
} -result 1

test cat-info-7 {fehlender Wert wird benannt} -body {
    catch {::pdf4tcl::catPdf -title} e
    expr {[string match {*missing*} $e]}
} -result 1

test cat-info-8 {die alte Aufrufform bleibt gueltig} -setup {
    catPlainDoc [file join [temporaryDirectory] p1.pdf] "eins"
    catPlainDoc [file join [temporaryDirectory] p2.pdf] "zwei"
} -body {
    # Kein Argument ist eine Option -- jeder bestehende Aufruf muss
    # unveraendert durchlaufen.
    ::pdf4tcl::catPdf [file join [temporaryDirectory] p1.pdf] \
            [file join [temporaryDirectory] p2.pdf] \
            [file join [temporaryDirectory] pout.pdf]
    file exists [file join [temporaryDirectory] pout.pdf]
} -result 1


# ---------------------------------------------------------------------------
# cat-xref-x  Was catPdf NICHT lesen kann, und wie es das sagt
#
# Eine Datei kann ihre Objekttabelle als STREAM fuehren statt als Tabelle
# (PDF 1.5+). Dann gibt es kein "trailer"-Schluesselwort, und dieser Leser
# steigt aus.
#
# Das trifft mehr als es klingt: PDF/A-1 VERBIETET xref-Streams, PDF/A-2
# und -3 VERLANGEN sie. Jedes Archivdokument ab 2b und jede
# ZUGFeRD-Rechnung landet hier.
#
# Vorher meldete es "can't read \"trailertxt\": no such variable" -- eine
# Tcl-Variable statt der Ursache.
# ---------------------------------------------------------------------------

test cat-xref-0 {PDF/A-2b laesst sich zusammenfuehren} -setup {
    foreach {n t} {q1 "Teil A" q2 "Teil B"} {
        set p [::pdf4tcl::new %AUTO% -paper a4 -pdfa 2b]
        $p metadata -title $t
        $p startPage
        $p setFont 12 Helvetica
        $p text "Inhalt $n" -x 60 -y 60
        $p write -file [file join [temporaryDirectory] $n.pdf]
        $p destroy
    }
} -body {
    # Seit 0.9.4.49. PDF/A-2 und -3 VERLANGEN einen xref-Stream, also war
    # bis dahin kein Archivdokument ab 2b und keine ZUGFeRD-Rechnung
    # zusammenfuehrbar.
    ::pdf4tcl::catPdf [file join [temporaryDirectory] q1.pdf] \
            [file join [temporaryDirectory] q2.pdf] \
            [file join [temporaryDirectory] qout.pdf]
    file exists [file join [temporaryDirectory] qout.pdf]
} -result 1

test cat-xref-0b {beide Seiten kommen mit} -setup {
    foreach {n t} {q1 "Teil A" q2 "Teil B"} {
        set p [::pdf4tcl::new %AUTO% -paper a4 -pdfa 2b]
        $p startPage
        $p setFont 12 Helvetica
        $p text "Inhalt $n" -x 60 -y 60
        $p write -file [file join [temporaryDirectory] $n.pdf]
        $p destroy
    }
} -body {
    # Eine Datei zu erzeugen genuegt nicht -- sie muss den Inhalt beider
    # Eingaben tragen.
    ::pdf4tcl::catPdf [file join [temporaryDirectory] q1.pdf] \
            [file join [temporaryDirectory] q2.pdf] \
            [file join [temporaryDirectory] qout.pdf]
    set fh [open [file join [temporaryDirectory] qout.pdf] rb]
    set data [read $fh]
    close $fh
    regexp -all {/Type\s*/Page\M} $data
} -result 2

test cat-xref-1 {gemischt: Stream-Form und Tabellenform} -setup {
    set p [::pdf4tcl::new %AUTO% -paper a4 -pdfa 2b]
    $p startPage
    $p setFont 12 Helvetica
    $p text "PDF/A-2b" -x 60 -y 60
    $p write -file [file join [temporaryDirectory] xr1.pdf]
    $p destroy
    catPlainDoc [file join [temporaryDirectory] xr2.pdf] "normal"
} -body {
    # Die eine Datei fuehrt einen xref-Stream, die andere eine Tabelle.
    # Beide Wege muessen dasselbe liefern, sonst faellt die Mischung auf.
    ::pdf4tcl::catPdf [file join [temporaryDirectory] xr1.pdf] \
            [file join [temporaryDirectory] xr2.pdf] \
            [file join [temporaryDirectory] xrout.pdf]
    set fh [open [file join [temporaryDirectory] xrout.pdf] rb]
    set data [read $fh]
    close $fh
    regexp -all {/Type\s*/Page\M} $data
} -result 2

test cat-xref-2 {Objekt-Streams werden ausgepackt} -setup {
    catPlainDoc [file join [temporaryDirectory] xr2.pdf] "normal"
} -constraints haveQpdf -body {
    # Objekte koennen in einem /ObjStm-Container liegen (Typ 2 in der
    # Tabelle). Bis 0.9.4.50 wurden sie abgelehnt; seither packt
    # UnpackObjStreams sie aus.
    #
    # qpdf schreibt solche Container standardmaessig, es ist also der
    # Normalfall und nicht der Sonderfall.
    exec qpdf --object-streams=generate \
            [file join [temporaryDirectory] xr2.pdf] \
            [file join [temporaryDirectory] xrobj.pdf]
    ::pdf4tcl::catPdf [file join [temporaryDirectory] xrobj.pdf] \
            [file join [temporaryDirectory] xr2.pdf] \
            [file join [temporaryDirectory] xrout.pdf]
    set fh [open [file join [temporaryDirectory] xrout.pdf] rb]
    set data [read $fh]
    close $fh
    regexp -all {/Type\s*/Page\M} $data
} -result 2

test cat-xref-2b {der PNG-Predictor wird zurueckgerechnet} \
        -constraints haveQpdf -setup {
    catPlainDoc [file join [temporaryDirectory] xr2.pdf] "normal"
} -body {
    # qpdf schreibt /DecodeParms << /Columns 4 /Predictor 12 >>: die
    # Zeilen der xref-Tabelle sind als Differenz zur vorigen gespeichert.
    #
    # Ohne Rueckrechnung sind alle Zeilen nach der ersten verschoben --
    # und die Datei laesst sich TROTZDEM lesen. Der Fehler zeigt sich
    # als unsinnige Objektnummern ("names object stream 0"), nicht als
    # Absturz. Deshalb dieser Test.
    exec qpdf --object-streams=generate \
            [file join [temporaryDirectory] xr2.pdf] \
            [file join [temporaryDirectory] xrobj.pdf]
    set fh [open [file join [temporaryDirectory] xrobj.pdf] rb]
    set data [read $fh]
    close $fh
    # Vorbedingung: die Datei benutzt den Predictor wirklich.
    if {![regexp {/Predictor\s+1[0-5]} $data]} {
        error "qpdf schrieb keinen Predictor -- der Test misst nichts"
    }
    set pdf [::pdf4tcl::cat::ReadPdf [file join [temporaryDirectory] xrobj.pdf]]
    # Der Katalog liegt im Container; ohne Rueckrechnung wird er nicht
    # gefunden.
    set rootId [lindex [dict get $pdf trailer /Root] 0]
    dict exists $pdf $rootId
} -result 1

test cat-xref-3 {PDF/A-1b geht weiterhin} -setup {
    foreach {n t} {xa "A" xb "B"} {
        set p [::pdf4tcl::new %AUTO% -paper a4 -pdfa 1b]
        $p metadata -title $t
        $p startPage
        $p setFont 12 Helvetica
        $p text "Teil $t" -x 60 -y 60
        $p write -file [file join [temporaryDirectory] $n.pdf]
        $p destroy
    }
} -body {
    # PDF/A-1 verbietet xref-Streams, also fuehrt es eine klassische
    # Tabelle -- und laesst sich zusammenfuehren.
    ::pdf4tcl::catPdf [file join [temporaryDirectory] xa.pdf] \
            [file join [temporaryDirectory] xb.pdf] \
            [file join [temporaryDirectory] xab.pdf]
    file exists [file join [temporaryDirectory] xab.pdf]
} -result 1

test cat-xref-4 {eine beschaedigte Datei wird benannt} -setup {
    set fh [open [file join [temporaryDirectory] kaputt.pdf] wb]
    puts -nonewline $fh "kein PDF"
    close $fh
    catPlainDoc [file join [temporaryDirectory] ok.pdf] "normal"
} -body {
    catch {::pdf4tcl::catPdf [file join [temporaryDirectory] kaputt.pdf] \
            [file join [temporaryDirectory] ok.pdf] \
            [file join [temporaryDirectory] kout.pdf]} e
    expr {[string match {*no startxref*} $e]}
} -result 1


test cat-xref-2c {ein PDF/A-2b mit Objekt-Streams bleibt konform} \
        -constraints {haveQpdf haveVerapdf} -setup {
    # Eingebettete Schrift, sonst faellt die Datei an Klausel 6.2.11.4.1
    # -- PDF/A verlangt jedes Fontprogramm in der Datei, und die
    # vierzehn Standardschriften haben keins.
    set ttf [file join [file dirname [file dirname [file normalize [info script]]]] \
            examples FreeSans.ttf]
    ::pdf4tcl::loadBaseTrueTypeFont VaBase $ttf
    ::pdf4tcl::createFontSpecCID VaBase VaFont
    foreach {n t} {va "Teil A" vb "Teil B"} {
        set p [::pdf4tcl::new %AUTO% -paper a4 -pdfa 2b]
        $p startPage
        $p setFont 12 VaFont
        $p text $t -x 60 -y 60
        $p write -file [file join [temporaryDirectory] $n.pdf]
        $p destroy
    }
} -body {
    # --newline-before-endstream ist noetig, weil qpdf ohne diese Option
    # Streams ohne EOL vor "endstream" schreibt und damit ISO 19005-2
    # Klausel 6.1.7.1 verletzt.
    #
    # DAS HAT MICH EINE STUNDE GEKOSTET: das zusammengefuehrte Dokument
    # fiel bei veraPDF durch, und ich habe den Fehler in catPdf gesucht.
    # Er lag in der EINGABE -- catPdf reicht die Streams unveraendert
    # durch, wie es soll. Nachgemessen: qpdf ohne die Option erzeugt
    # sechs von sieben Streams ohne EOL, und die Eingabe allein faellt
    # schon durch.
    exec qpdf --object-streams=generate --newline-before-endstream \
            [file join [temporaryDirectory] va.pdf] \
            [file join [temporaryDirectory] vaos.pdf]
    ::pdf4tcl::catPdf [file join [temporaryDirectory] vaos.pdf] \
            [file join [temporaryDirectory] vb.pdf] \
            [file join [temporaryDirectory] vout.pdf]
    set r [exec verapdf -f 2b --format text \
            [file join [temporaryDirectory] vout.pdf]]
    string match "PASS*" $r
} -result 1

# Auch die Dateien der Info- und xref-Tests wieder wegraeumen. Ohne das
# bleiben dreizehn PDFs im Arbeitsverzeichnis liegen -- tcltest meldet es
# als "files left behind", und beim naechsten Lauf ist das Rauschen, in
# dem ein echter Befund untergeht.
foreach pat {i?.pdf iout.pdf p?.pdf pout.pdf x?.pdf xab.pdf xr?.pdf
             kaputt.pdf ok.pdf kout.pdf xrout.pdf q?.pdf qout.pdf
             xrobj.pdf va.pdf vb.pdf vaos.pdf vout.pdf} {
    foreach f [glob -nocomplain -directory [temporaryDirectory] $pat] {
        file delete $f
    }
}

test cat-orphan-1 {das /Info des angehaengten Dokuments bleibt nicht liegen} -setup {
    foreach {n t} {o1 "Erstes" o2 "Zweites"} {
        set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
        $p metadata -title $t
        $p startPage
        $p setFont 12 Helvetica
        $p text "Inhalt $n" -x 60 -y 60
        $p write -file [file join [temporaryDirectory] $n.pdf]
        $p destroy
    }
} -body {
    # Zusammenfuehren uebernimmt jedes Objekt jeder Eingabe, auch das
    # /Info der angehaengten Dokumente. Der Trailer nennt nur eines, die
    # anderen blieben als Leichen liegen -- kein Leser sah sie, aber ein
    # grep fand den falschen Titel, und ein Test von mir mass ihn.
    ::pdf4tcl::catPdf -title "Gesamt" \
            [file join [temporaryDirectory] o1.pdf] \
            [file join [temporaryDirectory] o2.pdf] \
            [file join [temporaryDirectory] oout.pdf]
    set fh [open [file join [temporaryDirectory] oout.pdf] rb]
    set data [read $fh]
    close $fh
    # Genau ein /Title, und zwar der gesetzte.
    list [regexp -all {/Title} $data] \
         [expr {[string first "Zweites" $data] < 0}]
} -cleanup {
    foreach f {o1.pdf o2.pdf oout.pdf} {
        file delete [file join [temporaryDirectory] $f]
    }
} -result {1 1}

test cat-orphan-2 {/Size passt zur Objektzahl} -setup {
    foreach {n t} {o1 "Erstes" o2 "Zweites"} {
        set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
        $p metadata -title $t
        $p startPage
        $p setFont 12 Helvetica
        $p text "Inhalt $n" -x 60 -y 60
        $p write -file [file join [temporaryDirectory] $n.pdf]
        $p destroy
    }
} -body {
    # AppendPdf setzt /Size UND N, aber jeder Schritt danach --
    # DedupObjects, DropUnreachable -- aendert die Objektzahl und zieht
    # nur N nach. Der Trailer behielt den alten Wert.
    #
    # qpdf meldete das als Warnung, die Datei blieb lesbar, und die
    # Testsuite sah nichts. Deshalb dieser Test.
    ::pdf4tcl::catPdf -title "Gesamt" \
            [file join [temporaryDirectory] o1.pdf] \
            [file join [temporaryDirectory] o2.pdf] \
            [file join [temporaryDirectory] oout.pdf]
    set fh [open [file join [temporaryDirectory] oout.pdf] rb]
    set data [read $fh]
    close $fh
    regexp {/Size\s+(\d+)} $data -> size
    set maxOid 0
    foreach {full n} [regexp -all -inline {(?:^|\n)(\d+)\s+0\s+obj} $data] {
        if {$n > $maxOid} { set maxOid $n }
    }
    expr {$size == $maxOid + 1}
} -cleanup {
    foreach f {o1.pdf o2.pdf oout.pdf} {
        file delete [file join [temporaryDirectory] $f]
    }
} -result 1

test cat-orphan-3 {Seiten gehen dabei nicht verloren} -setup {
    foreach n {o1 o2} {
        set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
        $p startPage
        $p setFont 12 Helvetica
        $p text "Inhalt $n" -x 60 -y 60
        $p write -file [file join [temporaryDirectory] $n.pdf]
        $p destroy
    }
} -body {
    # Gegenprobe: eine Aufraeumroutine, die zu viel wegwirft, waere
    # schlimmer als die Leichen. Seiten und Strukturelemente bleiben
    # deshalb unangetastet, was der Erreichbarkeitslauf auch sagt.
    ::pdf4tcl::catPdf [file join [temporaryDirectory] o1.pdf] \
            [file join [temporaryDirectory] o2.pdf] \
            [file join [temporaryDirectory] oout.pdf]
    set fh [open [file join [temporaryDirectory] oout.pdf] rb]
    set data [read $fh]
    close $fh
    regexp -all {/Type\s*/Page\M} $data
} -cleanup {
    foreach f {o1.pdf o2.pdf oout.pdf} {
        file delete [file join [temporaryDirectory] $f]
    }
} -result 2

test cat-orphan-1 {das /Info des angehaengten Dokuments wird entfernt} -setup {
    foreach {n t} {o1 "Erstes" o2 "Zweites"} {
        set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
        $p metadata -title $t
        $p startPage
        $p setFont 12 Helvetica
        $p text "Inhalt $n" -x 60 -y 60
        $p write -file [file join [temporaryDirectory] $n.pdf]
        $p destroy
    }
} -body {
    # Beim Zusammenfuehren wandert jedes Objekt jeder Eingabe mit, auch
    # das /Info der angehaengten Dokumente. Der Trailer nennt nur eines,
    # die anderen bleiben als Leiche liegen -- kein Leser sieht sie, aber
    # wer die Datei durchsucht, findet einen Titel, der fuer nichts gilt.
    # Ein Test von mir hat deswegen den falschen gemessen.
    ::pdf4tcl::catPdf -title "Gesamt" \
            [file join [temporaryDirectory] o1.pdf] \
            [file join [temporaryDirectory] o2.pdf] \
            [file join [temporaryDirectory] oout.pdf]
    set fh [open [file join [temporaryDirectory] oout.pdf] rb]
    set data [read $fh]
    close $fh
    # Genau ein /Title, und zwar der gesetzte.
    list [regexp -all {/Title\s*\(} $data] \
         [expr {[string first "(Zweites)" $data] < 0}]
} -result {1 1}

test cat-orphan-2 {/Size zaehlt nach dem Aufraeumen richtig} -setup {
    foreach {n t} {o1 "Erstes" o2 "Zweites"} {
        set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
        $p metadata -title $t
        $p startPage
        $p setFont 12 Helvetica
        $p text "Inhalt $n" -x 60 -y 60
        $p write -file [file join [temporaryDirectory] $n.pdf]
        $p destroy
    }
} -body {
    # DropUnreachable entfernt Objekte und nummeriert um. Der Trailer
    # behielt den Wert vom Anhaengen, und qpdf meldete "reported number
    # of objects (19) is not one plus the highest object number (16)".
    # WritePdf leitet /Size jetzt aus N ab.
    ::pdf4tcl::catPdf -title "Gesamt" \
            [file join [temporaryDirectory] o1.pdf] \
            [file join [temporaryDirectory] o2.pdf] \
            [file join [temporaryDirectory] oout.pdf]
    set fh [open [file join [temporaryDirectory] oout.pdf] rb]
    set data [read $fh]
    close $fh
    regexp {/Size\s+(\d+)} $data -> size
    set maxOid 0
    foreach {full n} [regexp -all -inline {(?:^|\n)(\d+)\s+0\s+obj} $data] {
        if {$n > $maxOid} { set maxOid $n }
    }
    expr {$size == $maxOid + 1}
} -result 1

test cat-orphan-3 {Seiten bleiben, auch wenn der Scan sie nicht findet} -setup {
    foreach n {o1 o2} {
        set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
        $p startPage
        $p setFont 12 Helvetica
        $p text "Inhalt $n" -x 60 -y 60
        $p write -file [file join [temporaryDirectory] $n.pdf]
        $p destroy
    }
} -body {
    # Gegenprobe: das Aufraeumen darf nichts wegnehmen, was gebraucht
    # wird. Seiten und Strukturelemente sind ausdruecklich ausgenommen --
    # eine Seite fuer ein paar hundert Bytes zu verlieren waere ein
    # schlechter Tausch.
    ::pdf4tcl::catPdf [file join [temporaryDirectory] o1.pdf] \
            [file join [temporaryDirectory] o2.pdf] \
            [file join [temporaryDirectory] oout.pdf]
    set fh [open [file join [temporaryDirectory] oout.pdf] rb]
    set data [read $fh]
    close $fh
    regexp -all {/Type\s*/Page\M} $data
} -result 2

# Auch die Dateien der Info- und xref-Tests wieder wegraeumen. Ohne das
# bleiben dreizehn PDFs im Arbeitsverzeichnis liegen -- tcltest meldet es
# als "files left behind", und beim naechsten Lauf ist das Rauschen, in
# dem ein echter Befund untergeht.
foreach pat {i?.pdf iout.pdf p?.pdf pout.pdf x?.pdf xab.pdf xr?.pdf
             kaputt.pdf ok.pdf kout.pdf xrout.pdf q?.pdf qout.pdf
             xrobj.pdf va.pdf vb.pdf vaos.pdf vout.pdf
             o?.pdf oout.pdf} {
    foreach f [glob -nocomplain -directory [temporaryDirectory] $pat] {
        file delete $f
    }
}

::tcltest::cleanupTests