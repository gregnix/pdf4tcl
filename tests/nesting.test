# Test content stream operator nesting                              -*-tcl-*-
#
# ISO 32000-1 section 8.2: between BT and ET only text operators are
# allowed. q and Q are graphics operators (table 51) and must not appear
# there.
#
# This class of fault is invisible in normal use. Poppler, MuPDF, pdftotext
# and the Windows preview all render the page; Adobe Reader shows nothing at
# all -- no message, no hint, just a blank page. pdfinfo reports a healthy
# file: one page, right size, fonts embedded. It was found by comparing two
# PDFs from the same application, one of which stayed empty.
#
# So these tests read the content streams and check the nesting directly,
# rather than checking for the presence of a particular string. That catches
# the whole class, not just the one occurrence that prompted them.

source [file join [file dirname [file join [pwd] [info script]]] init.tcl]

# Return the content streams of a PDF as a list of decoded strings.
proc contentStreams {data} {
    set streams {}
    set pos 0
    while {1} {
        set i [string first "stream" $data $pos]
        if {$i < 0} break
        set j [string first "endstream" $data $i]
        if {$j < 0} break
        set body [string range $data [expr {$i + 6}] [expr {$j - 1}]]
        set body [string trimleft $body "\r\n"]
        if {[catch {zlib decompress $body} text]} {
            # uncompressed, or not a content stream at all
            set text $body
        }
        lappend streams $text
        set pos [expr {$j + 9}]
    }
    return $streams
}

# How many graphics operators sit inside a text object?
#
# Only whole lines are examined. pdf4tcl writes one operator per line, so
# this is exact for its own output and would merely under-report for a file
# written differently -- it never reports a fault that is not there.
proc graphicsInsideText {data} {
    set count 0
    foreach text [contentStreams $data] {
        set inText 0
        foreach line [split $text \n] {
            set line [string trim $line]
            if {$line eq "BT"} { set inText 1 ; continue }
            if {$line eq "ET"} { set inText 0 ; continue }
            if {$inText && $line in {q Q}} { incr count }
        }
    }
    return $count
}

# Are BT and ET balanced and never nested?
proc textObjectsBalanced {data} {
    foreach text [contentStreams $data] {
        set depth 0
        foreach line [split $text \n] {
            set line [string trim $line]
            if {$line eq "BT"} {
                incr depth
                if {$depth > 1} { return 0 }
            } elseif {$line eq "ET"} {
                incr depth -1
                if {$depth < 0} { return 0 }
            }
        }
        if {$depth != 0} { return 0 }
    }
    return 1
}

# -----------------------------------------------------------------------
# gsave and grestore
# -----------------------------------------------------------------------

test nesting-1.1 {gsave and grestore close an open text object} -body {
    # The case that prompted these tests. Before the fix the stream read
    #     BT ... q ... ET Q
    # and Adobe Reader showed a blank page while every other viewer was
    # happy.
    set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
    $p startPage
    $p setFont 12 Helvetica
    $p text "vor gsave" -x 40 -y 60
    $p gsave
    $p text "in gsave" -x 40 -y 90
    $p grestore
    $p text "nach grestore" -x 40 -y 120
    set data [$p get]
    $p destroy
    graphicsInsideText $data
} -result 0

test nesting-1.2 {the text objects stay balanced} -body {
    set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
    $p startPage
    $p setFont 12 Helvetica
    $p text "eins" -x 40 -y 60
    $p gsave
    $p text "zwei" -x 40 -y 90
    $p grestore
    set data [$p get]
    $p destroy
    textObjectsBalanced $data
} -result 1

test nesting-1.3 {the same with clip in between} -body {
    # How it turned up in practice: pdf4tcllib::labels::render with -clip 1
    # does gsave, clip, draw, grestore. clip closes the text object, gsave
    # and grestore did not.
    set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
    $p startPage
    $p setFont 12 Helvetica
    for {set i 0} {$i < 4} {incr i} {
        $p gsave
        $p clip 20 [expr {20 + $i * 40}] 200 30
        $p text "Etikett $i" -x 25 -y [expr {25 + $i * 40}]
        $p grestore
    }
    set data [$p get]
    $p destroy
    list [graphicsInsideText $data] [textObjectsBalanced $data]
} -result {0 1}

test nesting-1.4 {compressed streams are examined too} -body {
    # The default is compressed output; a check that only worked on
    # uncompressed files would miss every real document.
    set f [makeFile {} nesting-comp.pdf]
    set p [::pdf4tcl::new %AUTO% -paper a4 -compress 1 -file $f]
    $p startPage
    $p setFont 12 Helvetica
    $p text "eins" -x 40 -y 60
    $p gsave
    $p text "zwei" -x 40 -y 90
    $p grestore
    $p destroy
    set fh [open $f rb]
    set data [read $fh]
    close $fh
    list [graphicsInsideText $data] [textObjectsBalanced $data]
} -cleanup {
    removeFile nesting-comp.pdf
} -result {0 1}

# -----------------------------------------------------------------------
# The same for everything else that draws
# -----------------------------------------------------------------------

test nesting-2.1 {drawing between text keeps the nesting intact} -body {
    # Every drawing method has to close the text object. clip and rectangle
    # do it themselves, line, arc and circle through DrawLine. This walks a
    # representative set rather than trusting that.
    set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
    $p startPage
    $p setFont 12 Helvetica
    $p text "Anfang" -x 40 -y 40
    $p line 20 50 200 50
    $p text "nach line" -x 40 -y 70
    $p rectangle 20 80 100 20
    $p text "nach rectangle" -x 40 -y 110
    $p circle 60 140 20
    $p text "nach circle" -x 40 -y 170
    $p arc 60 200 40 20 0 90
    $p text "nach arc" -x 40 -y 230
    $p setFillColor 1 0 0
    $p text "nach setFillColor" -x 40 -y 260
    set data [$p get]
    $p destroy
    list [graphicsInsideText $data] [textObjectsBalanced $data]
} -result {0 1}

test nesting-2.2 {transformations too} -body {
    set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
    $p startPage
    $p setFont 12 Helvetica
    $p text "vor" -x 40 -y 40
    $p gsave
    $p translate 20 20
    $p rotate 15
    $p text "gedreht" -x 40 -y 70
    $p grestore
    $p text "nach" -x 40 -y 100
    set data [$p get]
    $p destroy
    list [graphicsInsideText $data] [textObjectsBalanced $data]
} -result {0 1}

testConstraint smilePng [file exists \
        [file join [file dirname [info script]] .. examples smile.png]]

test nesting-2.3 {an image between text} -constraints smilePng -body {
    set p [::pdf4tcl::new %AUTO% -paper a4 -compress 0]
    $p startPage
    $p setFont 12 Helvetica
    $p text "vor Bild" -x 40 -y 40
    set id [$p addImage [file join [file dirname [info script]] .. examples smile.png]]
    $p putImage $id 40 60 -width 60
    $p text "nach Bild" -x 40 -y 160
    set data [$p get]
    $p destroy
    list [graphicsInsideText $data] [textObjectsBalanced $data]
} -result {0 1}

# -----------------------------------------------------------------------
# The check itself
# -----------------------------------------------------------------------

test nesting-3.1 {the check recognises a faulty stream} -body {
    # A test that cannot fail proves nothing. This feeds it the broken shape
    # the bug produced and expects it to say so.
    set broken "BT\n/F1 12 Tf\nq\n1 0 0 1 10 10 cm\nET\nQ\n"
    set good   "BT\n/F1 12 Tf\nET\nq\n1 0 0 1 10 10 cm\nBT\nET\nQ\n"
    list [graphicsInsideText "stream\n$broken\nendstream"] \
            [graphicsInsideText "stream\n$good\nendstream"]
} -result {1 0}

test nesting-3.2 {the balance check recognises nesting and leftovers} -body {
    set nested   "BT\nBT\nET\nET\n"
    set leftover "BT\n/F1 12 Tf\n"
    set stray    "ET\n"
    set ok       "BT\nET\nBT\nET\n"
    list [textObjectsBalanced "stream\n$nested\nendstream"] \
            [textObjectsBalanced "stream\n$leftover\nendstream"] \
            [textObjectsBalanced "stream\n$stray\nendstream"] \
            [textObjectsBalanced "stream\n$ok\nendstream"]
} -result {0 0 0 1}

cleanupTests
