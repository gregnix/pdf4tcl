# Test the examples in the examples directory                        -*-tcl-*-
#
# $Id$

set thisDir [file dirname [file join [pwd] [info script]]]
source [file join $thisDir init.tcl]

if {![file exists tcl.jpg]} {
    file link tcl.jpg [file join $::pdf4tclTestRoot examples]/tcl.jpg
    file link gmarbles2.jpg [file join $::pdf4tclTestRoot examples]/gmarbles2.jpg
}

# Referenz-PDFs automatisch regenerieren wenn Tcl-Version sich geaendert hat.
# Tcl 8.6 und Tcl 9 erzeugen unterschiedliche ToUnicode-CMaps.
proc regenerateExampleRefs {} {
    set exdir  [file join $::pdf4tclTestRoot examples]
    set interp [info nameofexecutable]
    # Not only the interpreter: references made from another pdf4tcl (an
    # installed copy with the same number, an older state of the tree) must
    # not count as current. Gemessen 04.10.2026 unter Tcl 9.0.4/Windows:
    # .tclver stand auf 9.0.4, die Referenzen stammten von einer alten
    # Installation, examples-1.3 fiel durch.
    set lib [file join $::pdf4tclTestRoot pdf4tcl.tcl]
    set curver "[info patchlevel] [file size $lib] [file mtime $lib]"
    set verfile [file join $exdir .tclver]

    set stored ""
    catch { set stored [string trim [read [open $verfile r]]] }
    if {$stored eq $curver} { return }

    # Version hat sich geaendert -- alle Beispiele neu erzeugen
    puts "  (regenerating example PDFs for Tcl [info patchlevel])"
    set cwd [pwd]
    cd $exdir
    set fehler {}
    # Each example runs through a small boot script that reads the tree's
    # pkgIndex.tcl first. "set auto_path [linsert ...]" in the example is not
    # enough: under Tcl 9 an installed pdf4tcl with the same number can win
    # (same trap as in init.tcl).
    set boot [file join [temporaryDirectory] examples-boot.tcl]
    foreach n {0 1 2 3 4 5 6 -transform} {
        set skript test${n}.tcl
        if {![file exists $skript]} continue
        set fh [open $boot w]
        puts $fh [list apply {{dir} { source [file join $dir pkgIndex.tcl] }} \
                $::pdf4tclTestRoot]
        puts $fh [list set argv0 [file join $exdir $skript]]
        puts $fh {set argv {} ; set argc 0 ; source $argv0}
        close $fh
        if {[catch {exec $interp $boot} meldung]} {
            lappend fehler [list $skript [lindex [split $meldung \n] 0]]
        }
    }
    cd $cwd
    catch {file delete $boot}

    # Der Marker sagt "die Referenzen gehoeren zu diesem Interpreter".
    # Er darf deshalb NUR entstehen, wenn das auch stimmt.
    #
    # Vorher stand er unbedingt hinter der Schleife, und jedes exec lag in
    # einem catch ohne Zweig. Gemessen am 2026-09-03: test3 und test4 sind
    # die einzigen zwei der acht, die Tk brauchen. Ohne erreichbare Anzeige
    # scheiterten genau sie, der Marker wurde trotzdem geschrieben, und die
    # zwei Referenzen blieben auf dem Stand des anderen Interpreters --
    # sichtbar erst als Fehlschlag in examples-1.3 und -1.4, mit einer
    # Meldung ueber ToUnicode, die auf die falsche Faehrte fuehrt.
    if {[llength $fehler]} {
        puts "  WARNUNG: [llength $fehler] Beispiel(e) nicht neu erzeugt --\
                die Referenzen bleiben gemischt:"
        foreach paar $fehler {
            puts "    [lindex $paar 0]: [lindex $paar 1]"
        }
        puts "  Kein .tclver geschrieben; der naechste Lauf versucht es wieder."
        return
    }

    set fh [open $verfile w]
    puts $fh $curver
    close $fh
}

regenerateExampleRefs

# Compare two PDFs ignoring volatile timestamp fields.
proc pdfdiff {ref new} {
    # /ID is an FNV hash over the whole file (incl. the dates), so it changes
    # every run; ignore it like the date lines for content comparison.
    # xmp:MetadataDate kam mit 0.9.4.55 dazu und ist wie die anderen ein
    # Zeitstempel -- ohne diesen Eintrag scheitert jeder Beispielvergleich
    # an einer Sekunde Unterschied.
    set skipPat {/ModDate |/CreationDate |xmp:ModifyDate>|xmp:CreateDate>|xmp:MetadataDate>|/ID \[}
    proc _stripDates {file pat} {
        set fh [open $file rb]
        set lines [split [read $fh] \n]
        close $fh
        return [lsearch -all -inline -not -regexp $lines $pat]
    }
    set refF [_stripDates $ref $skipPat]
    set newF [_stripDates $new $skipPat]
    rename _stripDates {}
    if {$refF ne $newF} {
        error "PDFs differ (excluding timestamps)"
    }
    return {}
}

test examples-1.0 {example test0} -body {
    source [file join $::pdf4tclTestRoot examples]/test0.tcl
    pdfdiff [file join $::pdf4tclTestRoot examples]/test0.pdf test0.pdf
} -result {} -cleanup {catch {p1 destroy}}

test examples-1.1 {example test1} -body {
    source [file join $::pdf4tclTestRoot examples]/test1.tcl
    pdfdiff [file join $::pdf4tclTestRoot examples]/test1.pdf test1.pdf
} -result {} -cleanup {catch {p1 destroy}}

test examples-1.2 {example test2} -body {
    source [file join $::pdf4tclTestRoot examples]/test2.tcl
    pdfdiff [file join $::pdf4tclTestRoot examples]/test2.pdf test2.pdf
} -result {} -cleanup {catch {p1 destroy}}

test examples-1.3 {example test3} -constraints hasTk -body {
    # test3 contains an exit statement, stub it
    rename exit _exit
    proc exit args {}
    source [file join $::pdf4tclTestRoot examples]/test3.tcl
    # pdfdiff statt "exec diff": diff(1) gibt es auf Windows nicht, und
    # der Test brach mit "couldn't execute diff" ab, statt zu messen.
    # 1.1 und 1.2 benutzen es zwei Zeilen weiter oben laengst -- diese
    # zwei waren als einzige zurueckgeblieben. Gemeldet aus einem
    # Windows-Lauf 05.09.2026.
    pdfdiff [file join $::pdf4tclTestRoot examples]/test3.pdf test3.pdf
} -result {} -cleanup {catch {p1 destroy}; rename exit {} ; rename _exit exit}

test examples-1.4 {example test4} -constraints hasTk -body {
    # test4 contains an exit statement, stub it
    rename exit _exit
    proc exit args {}
    source [file join $::pdf4tclTestRoot examples]/test4.tcl
    pdfdiff [file join $::pdf4tclTestRoot examples]/test4.pdf test4.pdf
} -result {} -cleanup {catch {p1 destroy}; rename exit {} ; rename _exit exit}

test examples-1.5 {example test5} -body {
    source [file join $::pdf4tclTestRoot examples]/test5.tcl
    pdfdiff [file join $::pdf4tclTestRoot examples]/test5.pdf test5.pdf
} -result {} -cleanup {catch {p1 destroy}}

test examples-1.6 {example test6} -body {
    source [file join $::pdf4tclTestRoot examples]/test6.tcl
    pdfdiff [file join $::pdf4tclTestRoot examples]/test6.pdf test6.pdf
} -result {} -cleanup {catch {p1 destroy}}

test examples-1.7 {example test-transform} -body {
    source [file join $::pdf4tclTestRoot examples]/test-transform.tcl
    pdfdiff [file join $::pdf4tclTestRoot examples]/test-transform.pdf test-transform.pdf
} -result {} -cleanup {catch {$pdf destroy}}

# Cleanup
eval file delete [glob -nocomplain test*.pdf]
file delete tcl.jpg
file delete gmarbles2.jpg
::tcltest::cleanupTests
