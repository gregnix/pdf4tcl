# Tests for AES-128 encryption (V=4/R=4)
source [file join [file dirname [file join [pwd] [info script]]] init.tcl]

package require md5
package require aes

# ---------------------------------------------------------------------------
# Helper: check if a PDF has the Standard encrypt dictionary
proc hasEncryptDict {data} {
    return [regexp {/Filter /Standard} $data]
}

proc extractEntry {data key} {
    if {[regexp "/${key} <(\[0-9a-fA-F\]+)>" $data -> val]} {
        return $val
    }
    return ""
}

# ---------------------------------------------------------------------------
# 1. Basic: userpassword enables encryption
# ---------------------------------------------------------------------------
test encrypt-1.1 {userpassword triggers encryption} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "hello"]
    $p startPage
    $p setFont 12 Helvetica
    $p text "Secret" -x 72 -y 700
    $p endPage
    set data [$p get]
    $p destroy
    hasEncryptDict $data
} 1

test encrypt-1.2 {ownerpassword triggers encryption} {
    set p [pdf4tcl::new %AUTO% -paper a4 -ownerpassword "owner"]
    $p startPage
    $p setFont 12 Helvetica
    $p text "Secret" -x 72 -y 700
    $p endPage
    set data [$p get]
    $p destroy
    hasEncryptDict $data
} 1

test encrypt-1.3 {no password: no encryption} {
    set p [pdf4tcl::new %AUTO% -paper a4]
    $p startPage
    $p setFont 12 Helvetica
    $p text "Open" -x 72 -y 700
    $p endPage
    set data [$p get]
    $p destroy
    hasEncryptDict $data
} 0

# ---------------------------------------------------------------------------
# 2. Encrypt dictionary structure (V=4/R=4)
# ---------------------------------------------------------------------------
test encrypt-2.1 {encrypt dict has V=4} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    regexp {/V 4} $data
} 1

test encrypt-2.2 {encrypt dict has R=4} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    regexp {/R 4} $data
} 1

test encrypt-2.3 {encrypt dict has NO Length} {
    # Umgestellt in 0.9.4.53: /Length gehoert nur zu V 2 oder 3
    # (ISO 32000-1 Tabelle 20, ISO 32000-2 ebenso). Bei V 4 steht die
    # Laenge im Crypt-Filter -- /Length 16, siehe encrypt-2.4.
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    regexp {/Length 128} $data
} 0

test encrypt-2.4 {encrypt dict has AESV2 crypt filter} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    regexp {/CFM /AESV2} $data
} 1

test encrypt-2.5 {StmF and StrF reference StdCF} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    set ok [regexp {/StmF /StdCF} $data]
    set ok [expr {$ok && [regexp {/StrF /StdCF} $data]}]
    set ok
} 1

test encrypt-2.6 {O entry is 32 bytes} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    set ohex [extractEntry $data O]
    expr {[string length $ohex] == 64}
} 1

test encrypt-2.7 {U entry is 32 bytes} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    set uhex [extractEntry $data U]
    expr {[string length $uhex] == 64}
} 1

test encrypt-2.8 {U entry last 16 bytes are zero (Algorithm 5 step f)} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    set uhex [extractEntry $data U]
    # Last 16 bytes = chars 32..63 of hex string
    string equal [string range $uhex 32 end] [string repeat 00 16]
} 1

test encrypt-2.9 {P entry is -196 (all permissions, reserved bits clear)} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    regexp {/P -196} $data
} 1

# ---------------------------------------------------------------------------
# 3. Trailer entries
# ---------------------------------------------------------------------------
test encrypt-3.1 {trailer has /Encrypt reference} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    regexp {/Encrypt \d+ 0 R} $data
} 1

test encrypt-3.2 {trailer has /ID} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    regexp {/ID \[<[0-9a-fA-F]+>} $data
} 1

test encrypt-3.3 {encrypted PDF version >= 1.5} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage; $p endPage
    set data [$p get]; $p destroy
    regexp {%PDF-1\.[5-9]} $data
} 1

# ---------------------------------------------------------------------------
# 4. Stream encryption: content must not appear in plaintext
# ---------------------------------------------------------------------------
test encrypt-4.1 {page content stream is not plaintext} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p startPage
    $p setFont 12 Helvetica
    $p text "SensitiveText12345" -x 72 -y 700
    $p endPage
    set data [$p get]
    $p destroy
    # The text operator "SensitiveText12345" must not appear unencrypted
    expr {![string match *SensitiveText12345* $data]}
} 1

test encrypt-4.2 {encrypted PDF is larger than plain (IV overhead)} {
    set p1 [pdf4tcl::new %AUTO% -paper a4]
    $p1 startPage
    $p1 setFont 12 Helvetica
    $p1 text "Hello World" -x 72 -y 700
    $p1 endPage
    set plain [$p1 get]
    $p1 destroy

    set p2 [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw"]
    $p2 startPage
    $p2 setFont 12 Helvetica
    $p2 text "Hello World" -x 72 -y 700
    $p2 endPage
    set enc [$p2 get]
    $p2 destroy

    # Encrypted must be larger (encrypt dict + IV overhead)
    expr {[string length $enc] > [string length $plain]}
} 1

# ---------------------------------------------------------------------------
# 5. Algorithm correctness: RC4 internal
# ---------------------------------------------------------------------------
test encrypt-5.1 {RC4 encrypt/decrypt round-trip} {
    set p [pdf4tcl::new %AUTO% -paper a4]
    oo::objdefine $p export _RC4
    set key [binary format H32 0102030405060708090a0b0c0d0e0f10]
    set pt  "Hello World!!!!!"
    set ct  [$p _RC4 $key $pt]
    set dt  [$p _RC4 $key $ct]
    $p destroy
    string equal $dt $pt
} 1

test encrypt-5.2 {RC4 known vector: RFC6229 key=01..10} {
    # RFC 6229 first 16 bytes, key = 0102030405060708090a0b0c0d0e0f10 (16 bytes)
    set p [pdf4tcl::new %AUTO% -paper a4]
    oo::objdefine $p export _RC4
    set key [binary format H32 0102030405060708090a0b0c0d0e0f10]
    set pt  [string repeat "\x00" 16]
    set ct  [$p _RC4 $key $pt]
    $p destroy
    binary scan $ct H* cthex
    # Expected from RFC 6229 (key 16 bytes 01..10, first 16 bytes of keystream)
    string equal $cthex "9ac7cc9a609d1ef7b2932899cde41b97"
} 1

# ---------------------------------------------------------------------------
# 6. Algorithm correctness: per-object key (Algorithm 1)
# ---------------------------------------------------------------------------
test encrypt-6.1 {ObjKey returns 16 bytes} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "test"]
    $p startPage; $p endPage
    oo::objdefine $p export _ObjKey
    set key [$p _ObjKey 5]
    $p destroy
    string length $key
} 16

test encrypt-6.2 {ObjKey differs per OID} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "test"]
    $p startPage; $p endPage
    oo::objdefine $p export _ObjKey
    set k5 [$p _ObjKey 5]
    set k6 [$p _ObjKey 6]
    $p destroy
    expr {$k5 ne $k6}
} 1

# ---------------------------------------------------------------------------
# 7. EncryptBytes: structure
# ---------------------------------------------------------------------------
test encrypt-7.1 {EncryptBytes prepends 16-byte IV} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "test"]
    $p startPage; $p endPage
    oo::objdefine $p export EncryptBytes
    set pt [string repeat "A" 16]
    set ct [$p EncryptBytes 5 $pt]
    $p destroy
    # ct = 16 (IV) + 32 (padded AES block)
    string length $ct
} 48

test encrypt-7.2 {EncryptBytes: PKCS5 pad adds full block when aligned} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "test"]
    $p startPage; $p endPage
    oo::objdefine $p export EncryptBytes
    set pt [string repeat "B" 16]  ;# exactly 1 block
    set ct [$p EncryptBytes 5 $pt]
    $p destroy
    # 16 (IV) + 32 (16 data + 16 PKCS5 pad) = 48
    string length $ct
} 48

test encrypt-7.3 {EncryptBytes: 9-byte plaintext} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "test"]
    $p startPage; $p endPage
    oo::objdefine $p export EncryptBytes
    set pt [string repeat "C" 9]
    set ct [$p EncryptBytes 5 $pt]
    $p destroy
    # 16 (IV) + 16 (9 data padded to 16) = 32
    string length $ct
} 32

# ---------------------------------------------------------------------------
# 8. Multi-page encrypted document
# ---------------------------------------------------------------------------
test encrypt-8.1 {multi-page encrypted document builds without error} {
    set p [pdf4tcl::new %AUTO% -paper a4 -userpassword "pw" -ownerpassword "ow"]
    for {set i 1} {$i <= 3} {incr i} {
        $p startPage
        $p setFont 12 Helvetica
        $p text "Page $i" -x 72 -y 700
        $p endPage
    }
    set data [$p get]
    $p destroy
    set ok [hasEncryptDict $data]
    set ok [expr {$ok && [regexp {/Type /Pages} $data]}]
    set ok
} 1

# ---------------------------------------------------------------------------
# Empty streams under encryption (0.9.4.43)
# ---------------------------------------------------------------------------
#
# A form field without an initial value gets an appearance dictionary whose
# stream is empty -- the rule asks for the dictionary, not for its contents.
# EncryptStreamBody used [string replace $body $sstart ${send}-1 ...], and
# with an empty stream send equals sstart, so last is first-1 and Tcl leaves
# the string untouched. The ciphertext was dropped while /Length below it was
# set to the ciphertext length: /Length 32 over zero bytes. Every reader
# opened the file; qpdf reported "expected endstream" and recovered the
# length itself.

# Declared and actual length of the first /Subtype /Form stream.
# Returns {} when there is none -- the tests treat that as a failure, not as
# a pass: a helper that finds nothing must not make a test green.
proc formStreamLengths {data} {
    set idx [string first "/Subtype /Form" $data]
    if {$idx < 0} { return {} }
    set sstart [string first "stream\n" $data $idx]
    if {$sstart < 0} { return {} }
    incr sstart 7
    set send [string first "\nendstream" $data $sstart]
    if {$send < 0} { return {} }
    set head [string range $data $idx $sstart]
    if {![regexp {/Length ([0-9]+)} $head -> declared]} { return {} }
    return [list $declared [expr {$send - $sstart}]]
}

# A text field without an initial value: the appearance stream is empty,
# because ISO 19005 6.3.3 asks for the dictionary, not for contents.
#
# -pdfa only where no password is involved. Since 0.9.4.54 the two are
# refused together -- ISO 19005 clause 6.1.3 forbids an Encrypt key in a
# conforming file. The empty stream is written either way, so what these
# tests measure is unaffected.
proc emptyApDoc {args} {
    set p [::pdf4tcl::new %AUTO% -compress 0 -pdfa 3b {*}$args]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 700 100 20 -id leer
    set data [$p get]
    $p destroy
    return $data
}

test encrypt-empty-1.1 {without encryption an empty stream stays empty} -body {
    formStreamLengths [emptyApDoc]
} -result {0 0}

test encrypt-empty-1.2 {-pdfa and a password are refused together} -body {
    # Umgeschrieben in 0.9.4.54. Die beiden Tests hier massen frueher den
    # verschluesselten leeren Darstellungsstrom -- mit -pdfa 3b UND
    # -userpassword zugleich. Diese Kombination ist seither verboten:
    # ISO 19005 Klausel 6.1.3 laesst in einer konformen Datei keinen
    # Encrypt-Eintrag im Trailer zu, in keinem Teil der Norm.
    #
    # Nachmessbar ist der urspruengliche Gegenstand damit nicht mehr:
    # ohne -pdfa legt addForm ueberhaupt kein Aussehen-XObject an, der
    # leere Strom entsteht also nur unter PDF/A. Geblieben ist die
    # Zusicherung, dass die Kombination auffaellt statt still
    # durchzugehen.
    set rc [catch {emptyApDoc -userpassword geheim} e]
    list $rc [string match {*clause 6.1.3*} $e]
} -result {1 1}

test encrypt-empty-1.4 {the helper finds a stream at all} -body {
    # Guards the three tests above: if addForm ever stops writing an empty
    # appearance stream, they would pass on an empty result instead of
    # measuring anything.
    llength [formStreamLengths [emptyApDoc]]
} -result 2

# ---------------------------------------------------------------------------
# encrypt-20.x  Zeichenketten, die direkt geschrieben werden
# ---------------------------------------------------------------------------
#
# ISO 32000-2 Abschnitt 7.6.2 nennt genau vier Ausnahmen von der
# Verschluesselung: /ID im Trailer, Zeichenketten im Encrypt-Woerterbuch,
# Zeichenketten innerhalb bereits verschluesselter Stroeme, und die
# Contents einer Signatur. Alles andere gehoert verschluesselt.
#
# Zwei Objekte wurden direkt mit Pdfout hinausgeschrieben und liefen
# damit an EncryptStringsInBody vorbei: der Namensbaum der eingebetteten
# Dateien und die OCG-Woerterbuecher der Ebenen. Gemessen vor der
# Korrektur: /F und /UF im Filespec waren verschluesselt, der Name im
# Namensbaum stand im Klartext -- und der Anhang war unauffindbar.

tcltest::testConstraint haveQpdf [expr {![catch {exec qpdf --version}]}]

test encrypt-20.1 {Anhangsname im Namensbaum wird verschluesselt} -setup {
    set ::encAnhang [makeFile "Anhangsinhalt\n" enc-anhang.txt]
} -body {
    set p [pdf4tcl::new %AUTO% -paper a5 -compress 0 -userpassword geheim]
    $p startPage
    $p setFont 12 Helvetica
    $p text "Mit Anhang" -x 60 -y 60
    $p addEmbeddedFile $::encAnhang -mimetype text/plain -afrelationship Data
    set data [$p get]
    $p destroy
    # Der Dateiname darf nirgends im Klartext stehen.
    string first "enc-anhang.txt" $data
} -cleanup {
    removeFile enc-anhang.txt
} -result -1

test encrypt-20.2 {ohne Verschluesselung bleibt der Name lesbar} -setup {
    set ::encAnhang [makeFile "Anhangsinhalt\n" enc-anhang.txt]
} -body {
    # Gegenprobe: die Verschluesselung darf nur greifen, wo eine
    # verlangt wurde.
    set p [pdf4tcl::new %AUTO% -paper a5 -compress 0]
    $p startPage
    $p setFont 12 Helvetica
    $p addEmbeddedFile $::encAnhang -mimetype text/plain -afrelationship Data
    set data [$p get]
    $p destroy
    expr {[string first "enc-anhang.txt" $data] >= 0}
} -cleanup {
    removeFile enc-anhang.txt
} -result 1

test encrypt-20.3 {der Anhang bleibt auffindbar} \
        -constraints haveQpdf -setup {
    set ::encAnhang [makeFile "Anhangsinhalt\n" enc-anhang.txt]
} -body {
    # Der eigentliche Nachweis: qpdf muss den Anhang ueber seinen Namen
    # finden. Vor der Korrektur meldete es einen leeren Namen und
    # "attachment not found".
    set p [pdf4tcl::new %AUTO% -paper a5 -compress 0 -userpassword geheim]
    $p startPage
    $p setFont 12 Helvetica
    $p addEmbeddedFile $::encAnhang -mimetype text/plain -afrelationship Data
    set datei [file join [temporaryDirectory] enc-anhang.pdf]
    $p write -file $datei
    $p destroy
    set liste [exec qpdf --password=geheim --list-attachments $datei]
    set inhalt [exec qpdf --password=geheim \
            --show-attachment=enc-anhang.txt $datei]
    file delete $datei
    list [string match "enc-anhang.txt*" $liste] \
         [string match "*Anhangsinhalt*" $inhalt]
} -cleanup {
    removeFile enc-anhang.txt
} -result {1 1}

test encrypt-20.4 {Ebenenname wird verschluesselt} -body {
    # Dieselbe Ursache, zweite Fundstelle: die OCG-Woerterbuecher.
    set p [pdf4tcl::new %AUTO% -paper a5 -compress 0 -userpassword geheim]
    $p startPage
    $p setFont 12 Helvetica
    $p addLayer "Meine Ebene"
    $p text "T" -x 60 -y 60
    set data [$p get]
    $p destroy
    string first "Meine Ebene" $data
} -result -1

test encrypt-20.5 {entschluesselt ist der Ebenenname wieder da} \
        -constraints haveQpdf -body {
    # Verschluesseln, nicht zerstoeren: nach qpdf --decrypt muss der
    # Name wieder lesbar sein.
    set p [pdf4tcl::new %AUTO% -paper a5 -compress 0 -userpassword geheim]
    $p startPage
    $p setFont 12 Helvetica
    $p addLayer "Meine Ebene"
    $p text "T" -x 60 -y 60
    set datei [file join [temporaryDirectory] enc-layer.pdf]
    set klar  [file join [temporaryDirectory] enc-layer-klar.pdf]
    $p write -file $datei
    $p destroy
    exec qpdf --password=geheim --decrypt $datei $klar
    set fh [open $klar rb]
    set data [read $fh]
    close $fh
    file delete $datei $klar
    expr {[string first "Meine Ebene" $data] >= 0}
} -result 1

# ---------------------------------------------------------------------------
# Verschluesselung UND eingebettete Schrift zusammen
#
# Beide Eigenschaften sind einzeln geprueft -- Verschluesselung in dieser
# Datei, CID/TTF-Schriften in new-0.9.4.35.test -- aber nie gemeinsam.
# Genau dort sass der Fehler: die Objekte aus WriteCIDFontObjects gingen
# mit Pdfout an EncryptStreamBody vorbei. Das PDF entstand, war ohne
# Kennwort dicht, liess sich aber MIT Kennwort nicht lesen.
# Gemessen 14.09.2026 an 0.9.4.66.

# DejaVuSans.ttf for the CID cases; without it they are skipped.
set ::encDejavu ""
set encFontDirs {/usr/share/fonts/truetype/dejavu /usr/share/fonts/TTF
    /usr/share/fonts/dejavu /Library/Fonts}
if {[info exists ::env(WINDIR)]} { lappend encFontDirs [file join $::env(WINDIR) Fonts] }
if {[info exists ::env(LOCALAPPDATA)]} {
    lappend encFontDirs [file join $::env(LOCALAPPDATA) Microsoft Windows Fonts]
}
foreach encFd $encFontDirs {
    if {[file readable [file join $encFd DejaVuSans.ttf]]} {
        set ::encDejavu [file join $encFd DejaVuSans.ttf] ; break
    }
}
unset -nocomplain encFd encFontDirs
testConstraint DejaVuSans [expr {$::encDejavu ne ""}]

test encrypt-cid-1.0 {verschluesseltes PDF mit eingebetteter CID-Schrift
        ist mit Kennwort lesbar} -constraints {haveQpdf DejaVuSans} -setup {
    set ttf $::encDejavu
} -body {
    pdf4tcl::loadBaseTrueTypeFont EncCidBase $ttf
    pdf4tcl::createFontSpecCID EncCidBase EncCidUni
    set p [::pdf4tcl::new %AUTO% -paper a4 \
            -userpassword geheim -permissions {print}]
    $p startPage
    $p setFont 12 EncCidUni
    $p text "CID-PROBE-4711" -x 60 -y 700
    set datei [file join [temporaryDirectory] enc-cid.pdf]
    $p write -file $datei
    $p destroy

    # qpdf darf keine Stromfehler melden -- genau die traten vorher auf
    # ("inflate: incorrect header check" an den /Length1-Objekten).
    set pruef ""
    catch {exec qpdf --password=geheim --check $datei 2>@1} pruef
    set stromfehler [regexp -all {error decoding stream data} $pruef]

    # und der Text muss mit Kennwort herauskommen
    set klar [file join [temporaryDirectory] enc-cid-klar.pdf]
    exec qpdf --password=geheim --decrypt $datei $klar
    set fh [open $klar rb] ; set data [read $fh] ; close $fh
    file delete -force $datei $klar
    list $stromfehler [expr {[string length $data] > 0}]
} -result {0 1}

test encrypt-cid-1.1 {ohne Kennwort bleibt dasselbe PDF dicht} \
        -constraints {haveQpdf DejaVuSans} -setup {
    set ttf $::encDejavu
} -body {
    pdf4tcl::loadBaseTrueTypeFont EncCidBase2 $ttf
    pdf4tcl::createFontSpecCID EncCidBase2 EncCidUni2
    set p [::pdf4tcl::new %AUTO% -paper a4 -userpassword geheim]
    $p startPage ; $p setFont 12 EncCidUni2
    $p text "CID-PROBE-4711" -x 60 -y 700
    set datei [file join [temporaryDirectory] enc-cid2.pdf]
    $p write -file $datei
    $p destroy
    # Ohne Kennwort muss qpdf scheitern.
    set rc [catch {exec qpdf --check $datei 2>@1}]
    file delete -force $datei
    set rc
} -result 1

# ---------------------------------------------------------------------------
# Der XMP-Strom gehoert mitverschluesselt
#
# Die Datei schreibt /EncryptMetadata true; ein Leser entschluesselt
# den Strom daraufhin. Blieb er im Klartext, bekam er Buchstabensalat --
# und der Titel stand ausserdem lesbar in einer angeblich
# verschluesselten Datei. Gemessen 14.09.2026 an 0.9.4.66.
#
# qpdf --check findet das NICHT: der XMP-Strom ist unkomprimiert, es
# gibt also kein Entpacken, das scheitern koennte. Darum wird hier in
# den Rohbytes nachgesehen.

test encrypt-xmp-1.0 {XMP-Metadaten stehen nicht im Klartext} -body {
    set p [::pdf4tcl::new %AUTO% -paper a4 -userpassword geheim]
    $p metadata -title "XMPMARKE-4711"
    $p startPage ; $p setFont 12 Helvetica ; $p text "X" -x 50 -y 700
    set datei [file join [temporaryDirectory] enc-xmp.pdf]
    $p write -file $datei
    $p destroy
    set fh [::open $datei rb] ; set roh [read $fh] ; close $fh
    file delete -force $datei
    string first "XMPMARKE-4711" $roh
} -result -1

test encrypt-xmp-1.1 {ohne Verschluesselung steht er sehr wohl da} -body {
    # Gegenprobe: ohne -userpassword muss die Marke auffindbar sein.
    # Sonst prueft der Fall oben nur, dass metadata gar nichts schreibt.
    set p [::pdf4tcl::new %AUTO% -paper a4]
    $p metadata -title "XMPMARKE-4711"
    $p startPage ; $p setFont 12 Helvetica ; $p text "X" -x 50 -y 700
    set datei [file join [temporaryDirectory] klar-xmp.pdf]
    $p write -file $datei
    $p destroy
    set fh [::open $datei rb] ; set roh [read $fh] ; close $fh
    file delete -force $datei
    expr {[string first "XMPMARKE-4711" $roh] >= 0}
} -result 1

test encrypt-strings-1.0 {kein Literalstring der Klarfassung ueberlebt} -body {
    # Breiter als ein einzelnes Merkmal: ALLE Literalstrings beider
    # Dateien vergleichen. Was in beiden gleich dasteht, ist nicht
    # verschluesselt worden.
    proc ::EncStrings {datei} {
        set fh [::open $datei rb] ; set d [read $fh] ; close $fh
        set out {}
        foreach m [regexp -all -inline {\(([ -~]{6,})\)} $d] {
            if {[string index $m 0] ne "("} { lappend out $m }
        }
        return [lsort -unique $out]
    }
    set gemeinsam {}
    foreach {name opts} {klar {} enc {-userpassword geheim}} {
        set p [::pdf4tcl::new %AUTO% -paper a4 {*}$opts]
        $p metadata -title "STRMARKE-4711"
        $p startPage ; $p setFont 12 Helvetica
        $p text "Seite" -x 50 -y 700
        $p bookmarkAdd -title "LESEMARKE-4711"
        $p hyperlinkAdd 50 650 150 20 "https://LINKMARKE.example"
        set d($name) [file join [temporaryDirectory] str-$name.pdf]
        $p write -file $d($name)
        $p destroy
    }
    set k [::EncStrings $d(klar)]
    set e [::EncStrings $d(enc)]
    foreach s $k { if {$s in $e} { lappend gemeinsam $s } }
    file delete -force $d(klar) $d(enc)
    rename ::EncStrings {}
    list [expr {[llength $k] > 0}] $gemeinsam
} -result {1 {}}

test encrypt-cid-2.0 {AES-256 mit eingebetteter Schrift} \
        -constraints {haveQpdf DejaVuSans} -setup {
    set ttf $::encDejavu
} -body {
    # -encversion 5 geht einen anderen Schluesselweg als AESv2. Die
    # Behebung an WriteCIDFontObjects gilt fuer beide, das war aber
    # unbelegt, bis dieser Fall dazukam (14.09.2026).
    pdf4tcl::loadBaseTrueTypeFont Enc256Base $ttf
    pdf4tcl::createFontSpecCID Enc256Base Enc256Uni
    set p [::pdf4tcl::new %AUTO% -paper a4 -userpassword geheim -encversion 5]
    $p startPage ; $p setFont 12 Enc256Uni
    $p text "AES256-PROBE" -x 60 -y 700
    set datei [file join [temporaryDirectory] enc-cid256.pdf]
    $p write -file $datei
    $p destroy
    set pruef ""
    catch {exec qpdf --password=geheim --check $datei 2>@1} pruef
    set stromfehler [regexp -all {error decoding stream data} $pruef]
    set aesv3 [regexp {AESv3} $pruef]
    file delete -force $datei
    list $stromfehler $aesv3
} -result {0 1}

# ---------------------------------------------------------------------------
# Die allgemeine Probe: kein Byte der Klarfassung ueberlebt
#
# Die Faelle oben pruefen je EINE Eigenschaft -- Anhangsname, Ebenenname,
# XMP, CID-Schrift. Jeder davon entstand, nachdem ein Fehler aufgefallen
# war. Was niemandem einfaellt, wird nicht geprueft.
#
# Dieser Fall geht andersherum: dasselbe Dokument zweimal bauen, einmal
# klar und einmal verschluesselt, und verlangen, dass KEIN Strom
# bytegleich ist. Ein Strom, der die Verschluesselung umgeht, steht
# unveraendert da -- unabhaengig davon, wozu er gehoert.
#
# Gemessen 14.09.2026: beide Fehler dieser Fassung waren genau das --
# die CID-Schriftstroeme und der XMP-Strom standen Byte fuer Byte wie
# in der unverschluesselten Datei.

proc ::EncStreams {datei} {
    set fh [::open $datei rb] ; set d [read $fh] ; close $fh
    set out {}
    set pos 0
    while {1} {
        # "endstream" enthaelt selbst "stream" -- daher die Abgrenzung.
        if {![regexp -start $pos -indices {(^|[^a-zA-Z])stream\r?\n} $d m]} break
        set s [expr {[lindex $m 1] + 1}]
        set e [string first "endstream" $d $s]
        if {$e < 0} break
        set roh [string range $d $s [expr {$e - 1}]]
        if {[string length $roh] > 16} { lappend out $roh }
        set pos $e
    }
    return $out
}

proc ::EncBaue {datei opts} {
    set p [::pdf4tcl::new %AUTO% -paper a4 {*}$opts]
    $p metadata -title "ALLPROBE-XMP"
    $p startPage
    $p setFont 12 Helvetica
    $p text "ALLPROBE-SEITE" -x 50 -y 750
    $p bookmarkAdd -title "ALLPROBE-LESEZEICHEN"
    $p hyperlinkAdd 50 700 150 20 "https://ALLPROBE-LINK.example"
    catch {
        $p addLayer "ALLPROBE-EBENE"
    }
    set ttf $::encDejavu
    if {[file readable $ttf]} {
        catch {
            pdf4tcl::loadBaseTrueTypeFont AllProbeBase $ttf
            pdf4tcl::createFontSpecCID AllProbeBase AllProbeUni
            $p setFont 12 AllProbeUni
            $p text "ALLPROBE-CID" -x 50 -y 650
        }
    }
    $p write -file $datei
    $p destroy
}

test encrypt-all-1.0 {kein Strom ueberlebt die Verschluesselung unveraendert} -body {
    set klar [file join [temporaryDirectory] all-klar.pdf]
    set enc  [file join [temporaryDirectory] all-enc.pdf]
    ::EncBaue $klar {}
    ::EncBaue $enc  {-userpassword geheim}
    set k [::EncStreams $klar]
    set e [::EncStreams $enc]
    set gleich 0
    foreach s $k { if {$s in $e} { incr gleich } }
    file delete -force $klar $enc
    # erste Zahl: es wurden ueberhaupt Stroeme gefunden
    list [expr {[llength $k] > 2}] $gleich
} -result {1 0}

test encrypt-all-1.1 {kein Literalstring ueberlebt} -body {
    set klar [file join [temporaryDirectory] all2-klar.pdf]
    set enc  [file join [temporaryDirectory] all2-enc.pdf]
    ::EncBaue $klar {}
    ::EncBaue $enc  {-userpassword geheim}
    array unset d
    foreach {n f} [list klar $klar enc $enc] {
        set fh [::open $f rb] ; set roh [read $fh] ; close $fh
        set l {}
        foreach m [regexp -all -inline {\(([ -~]{6,})\)} $roh] {
            if {[string index $m 0] ne "("} { lappend l $m }
        }
        set d($n) [lsort -unique $l]
    }
    set gemeinsam {}
    foreach s $d(klar) { if {$s in $d(enc)} { lappend gemeinsam $s } }
    file delete -force $klar $enc
    list [expr {[llength $d(klar)] > 0}] $gemeinsam
} -result {1 {}}

test encrypt-all-1.2 {und mit Kennwort ist alles wieder da} \
        -constraints haveQpdf -body {
    # Gegenrichtung: die Verschluesselung darf nicht dadurch "gelingen",
    # dass der Inhalt kaputtgeht. qpdf muss die Datei sauber
    # entschluesseln koennen.
    set enc  [file join [temporaryDirectory] all3-enc.pdf]
    set klar [file join [temporaryDirectory] all3-back.pdf]
    ::EncBaue $enc {-userpassword geheim}
    set pruef ""
    catch {exec qpdf --password=geheim --check $enc 2>@1} pruef
    set fehler [regexp -all {error decoding stream data} $pruef]
    exec qpdf --password=geheim --decrypt $enc $klar
    set fh [::open $klar rb] ; set zurueck [read $fh] ; close $fh
    set marken 0
    foreach m {ALLPROBE-XMP ALLPROBE-LESEZEICHEN ALLPROBE-LINK} {
        if {[string first $m $zurueck] >= 0} { incr marken }
    }
    file delete -force $enc $klar
    list $fehler $marken
} -result {0 3}

# Katalog-Strings (/Lang, /OCProperties /D /Name) werden direkt in Objekt 1
# geschrieben. encrypt-all-1.1 sieht erst Strings ab 6 Zeichen -- "de"
# rutscht durch. Hier die kurze Sprache gezielt.
proc ::EncKatalog {datei opts} {
    set p [pdf4tcl::new %AUTO% -compress 0 {*}$opts]
    $p tagged 1 -lang de
    set l [$p addLayer "Raster" -print 0]
    $p startPage
    $p setFont 12 Helvetica
    $p tagText P "Hallo" -x 50 -y 50
    $p beginLayer $l; $p line 0 0 10 10; $p endLayer
    $p endPage
    $p write -file $datei
    $p destroy
}
test encrypt-cat-1.0 {/Lang und /Name im Katalog sind verschluesselt} -body {
    set klar [file join [temporaryDirectory] cat-klar.pdf]
    set enc  [file join [temporaryDirectory] cat-enc.pdf]
    ::EncKatalog $klar {}
    ::EncKatalog $enc {-userpassword geheim}
    set r {}
    foreach f [list $klar $enc] {
        set fh [::open $f rb] ; set roh [read $fh] ; close $fh
        lappend r [regexp {/Lang \(de\)} $roh] [regexp {/Name \(Default\)} $roh]
    }
    file delete -force $klar $enc
    set r
} -result {1 1 0 0}

test encrypt-cat-1.1 {und entschluesselt stehen sie wieder da} \
        -constraints haveQpdf -body {
    set enc [file join [temporaryDirectory] cat-enc2.pdf]
    ::EncKatalog $enc {-userpassword geheim}
    set kat [exec qpdf --password=geheim --show-object=1 $enc]
    file delete -force $enc
    list [regexp {/Lang \(de\)} $kat] [regexp {/Name \(Default\)} $kat]
} -result {1 1}

