# ---------------------------------------------------------------
# 11. fillForms (0.9.4.50)
#
# Das Gegenstueck zu getForms: dieselbe Suche nach /Widget, aber der
# Wert wird geschrieben statt gelesen.
# ---------------------------------------------------------------

# 21./22. -- fillForms und getForms.
#
# Eigene Nummern, weil 11.x und 12.x weiter oben schon fuer addForm
# vergeben sind. Zwei Tests mit demselben Namen fuehrt tcltest beide
# aus, aber ein Fehlerbericht nennt nur die Nummer -- und man sucht
# dann an der falschen Stelle.

test form-21.1 {fillForms setzt einen Textwert} -body {
    mytest -file {addForm text 0 0 100 20 -id name} {}
    set n [pdf4tcl::fillForms testdebug.pdf testfilled.pdf {name "Meier"}]
    set res [pdf4tcl::getForms testfilled.pdf]
    list $n [dict get $res name value]
} -cleanup {
    file delete testdebug.pdf testfilled.pdf
} -result {1 Meier}

test form-21.2 {Sonderzeichen werden maskiert} -body {
    # Eine unmaskierte Klammer beendet die PDF-Zeichenkette vorzeitig --
    # das ist der Fall, den dieser Test wirklich absichert.
    #
    # Das "&" steht mit im Wert, weil es in einer frueheren Fassung als
    # Rueckverweis im regsub gelesen wurde ("Meier << Co"). Inzwischen
    # greift ein anderes Muster und der Fall tritt nicht mehr auf -- der
    # Test wuerde ihn also NICHT fangen. Er bleibt trotzdem stehen: die
    # Erwartung ist richtig, und wer das Muster aendert, sieht es hier.
    mytest -file {addForm text 0 0 100 20 -id firma} {}
    pdf4tcl::fillForms testdebug.pdf testfilled.pdf {firma "Meier & Co (GmbH)"}
    set res [pdf4tcl::getForms testfilled.pdf]
    dict get $res firma value
} -cleanup {
    file delete testdebug.pdf testfilled.pdf
} -result {Meier & Co (GmbH)}

test form-21.3 {eine Checkbox nimmt einen Zustandsnamen} -body {
    mytest -file {addForm checkbutton 0 0 15 15 -id ok} {}
    pdf4tcl::fillForms testdebug.pdf testfilled.pdf {ok /Yes}
    set res [pdf4tcl::getForms testfilled.pdf]
    # /AS muss mitgesetzt werden, sonst zeigt das Kaestchen sein altes
    # Aussehen.
    list [dict get $res ok value] [dict get $res ok default]
} -cleanup {
    file delete testdebug.pdf testfilled.pdf
} -result {/Yes /Yes}

test form-21.4 {ein unbekanntes Feld wird gemeldet} -body {
    # Stillschweigend zu uebergehen hiesse: das Formular kommt leer
    # heraus und niemand weiss warum.
    mytest -file {addForm text 0 0 100 20 -id name} {}
    catch {pdf4tcl::fillForms testdebug.pdf testfilled.pdf {quatsch A}} e
    expr {[string match {*no such field*quatsch*} $e]}
} -cleanup {
    file delete testdebug.pdf
    catch {file delete testfilled.pdf}
} -result 1

test form-21.5 {nicht genannte Felder bleiben unveraendert} -body {
    mytest -file {addForm text 0 0 100 20 -id eins} \
            {addForm text 0 30 100 20 -id zwei} {}
    pdf4tcl::fillForms testdebug.pdf testfilled.pdf {eins "A"}
    set res [pdf4tcl::getForms testfilled.pdf]
    list [dict get $res eins value] [dict get $res zwei value]
} -cleanup {
    file delete testdebug.pdf testfilled.pdf
} -result {A {}}

test form-21.6 {NeedAppearances wird gesetzt} -body {
    # Ohne das traegt das Feld den Wert und zeigt das alte Aussehen.
    mytest -file {addForm text 0 0 100 20 -id name} {}
    pdf4tcl::fillForms testdebug.pdf testfilled.pdf {name "Meier"}
    set fh [open testfilled.pdf rb]
    set data [read $fh]
    close $fh
    expr {[string first "NeedAppearances" $data] >= 0}
} -cleanup {
    file delete testdebug.pdf testfilled.pdf
} -result 1

test form-21.7 {ein leeres dict aendert nichts} -body {
    mytest -file {addForm text 0 0 100 20 -id name} {}
    pdf4tcl::fillForms testdebug.pdf testfilled.pdf {}
} -cleanup {
    file delete testdebug.pdf
    catch {file delete testfilled.pdf}
} -result 0

test form-21.8 {der gefuellte Wert kommt im FDF-Export an} -body {
    # Der ganze Kreis: fuellen, auslesen, exportieren.
    mytest -file {addForm text 0 0 100 20 -id name} {}
    pdf4tcl::fillForms testdebug.pdf testfilled.pdf {name "Schmidt"}
    pdf4tcl::exportForms testfilled.pdf testexport.fdf
    set fh [open testexport.fdf]
    set data [read $fh]
    close $fh
    expr {[string first "Schmidt" $data] >= 0}
} -cleanup {
    file delete testdebug.pdf testfilled.pdf testexport.fdf
} -result 1


test form-22.1 {getForms vertraegt ein Widget ohne Namen} -body {
    # Bei einem Optionsfeld traegt der Elternknoten den Namen, die
    # Kinder nur ihr Aussehen -- sie haben kein /T. getForms brach
    # daran ab:
    #
    #   key "/T" not known in dictionary
    #
    # Gefunden beim Erweitern von demo/demo-forms.tcl, nicht von der
    # Testsuite: kein Test hatte ein Optionsfeld ausgelesen.
    mytest -file {addForm radiobutton 0 0 15 15 -group wahl -value A} \
            {addForm radiobutton 0 30 15 15 -group wahl -value B} \
            {addForm text 0 60 100 20 -id name} {}
    set res [pdf4tcl::getForms testdebug.pdf]
    # Das benannte Feld kommt durch, die namenlosen Kinder werden
    # uebergangen.
    dict get $res name type
} -cleanup {file delete testdebug.pdf} -result "/Tx"

test form-22.2 {fillForms ebenso} -body {
    mytest -file {addForm radiobutton 0 0 15 15 -group wahl -value A} \
            {addForm text 0 60 100 20 -id name} {}
    pdf4tcl::fillForms testdebug.pdf testfilled.pdf {name "Meier"}
    set res [pdf4tcl::getForms testfilled.pdf]
    dict get $res name value
} -cleanup {
    file delete testdebug.pdf testfilled.pdf
} -result {Meier}


test form-21.2a {der Rundlauf ist stabil} -body {
    # Auslesen, ein Feld aendern, zurueckschreiben -- und das dreimal.
    # Vorher verdoppelte sich dabei die Maskierung JEDES Feldes, das
    # nicht angefasst wurde, bei jedem Durchgang:
    #
    #   Meier & Co (GmbH)
    #   (Meier & Co \(GmbH\))
    #   (\(Meier & Co \\\(GmbH\\\)\)))
    #
    # Zwei Fehler, einer je Richtung: getForms gab den Wert roh zurueck,
    # und das Schreibmuster endete an der ersten maskierten Klammer.
    #
    # Raeumt zu Beginn auf, nicht nur am Ende: nach einem abgebrochenen
    # Lauf nahm der Test sonst die alte Datei als Eingabe und fiel mit
    # genau dem Wert durch, den er ausschliessen soll.
    foreach f {rtA.pdf rtB.pdf rtC.pdf rtD.pdf} {
        catch {file delete $f}
    }
    mytest -file {addForm text 0 0 100 20 -id firma} \
            {addForm text 0 30 100 20 -id ort} {}
    file rename testdebug.pdf rtA.pdf

    pdf4tcl::fillForms rtA.pdf rtB.pdf {firma "Meier & Co (GmbH)" ort "A"}
    foreach {von nach} {rtB.pdf rtC.pdf rtC.pdf rtD.pdf} {
        set alt [pdf4tcl::getForms $von]
        set neu {}
        dict for {k v} $alt { dict set neu $k [dict get $v value] }
        dict set neu ort "geaendert"
        pdf4tcl::fillForms $von $nach $neu
    }
    dict get [pdf4tcl::getForms rtD.pdf] firma value
} -cleanup {
    foreach f {rtA.pdf rtB.pdf rtC.pdf rtD.pdf} { catch {file delete $f} }
} -result {Meier & Co (GmbH)}

test form-21.2b {ein Name-Wert bleibt unangetastet} -body {
    # Checkboxen tragen /Yes oder /Off -- genau die Form, die fillForms
    # erwartet. Auspacken duerfte sie nicht.
    mytest -file {addForm checkbutton 0 0 15 15 -id ok} {}
    pdf4tcl::fillForms testdebug.pdf testfilled.pdf {ok /Yes}
    dict get [pdf4tcl::getForms testfilled.pdf] ok value
} -cleanup {
    file delete testdebug.pdf testfilled.pdf
} -result "/Yes"


# ---------------------------------------------------------------------------
# form-23.x  Optionen zum falschen Feldtyp (0.9.4.56)
#
# "addForm text ... -value x" setzte nichts und meldete nichts. -value ist
# der Ausgabename eines Optionsfeldes, ein Textfeld nimmt -init.
#
# Gemeldet, nicht abgelehnt: wer heute eine harmlose Zusatzoption
# uebergibt, soll nicht stehenbleiben. Die Zuordnung ist aus der
# Gliederung des Handbuchs abgelesen, nicht geraten.
# ---------------------------------------------------------------------------

test form-23.1 {-value an einem Textfeld wird gemeldet} -body {
    set ::pdf4tcl::warnings {}
    mytest -file {addForm text 0 0 100 20 -id a -value X} {}
    file delete testdebug.pdf
    expr {[llength [lsearch -all -inline $::pdf4tcl::warnings \
            {*-value applies to radiobutton*}]] == 1}
} -cleanup {set ::pdf4tcl::warnings {}} -result 1

test form-23.2 {-options an einem Textfeld ebenso} -body {
    set ::pdf4tcl::warnings {}
    mytest -file {addForm text 0 0 100 20 -id b -options {A B}} {}
    file delete testdebug.pdf
    expr {[llength [lsearch -all -inline $::pdf4tcl::warnings \
            {*-options applies to combobox, listbox*}]] == 1}
} -cleanup {set ::pdf4tcl::warnings {}} -result 1

test form-23.3 {richtige Zuordnung meldet nichts} -body {
    # Gegenprobe. Eine Tabelle, die immer meldet, waere schlimmer als
    # keine -- sie wuerde gueltige Aufrufe verdaechtigen.
    set ::pdf4tcl::warnings {}
    mytest -file {addForm radiobutton 0 0 15 15 -group g -value ja} \
            {addForm text 0 30 100 20 -id c -init "ok" -multiline 1} \
            {addForm combobox 0 60 100 20 -id d -options {A B} -sort 1} \
            {addForm pushbutton 0 90 90 20 -id e -caption "OK" -action reset} {}
    file delete testdebug.pdf
    llength $::pdf4tcl::warnings
} -cleanup {set ::pdf4tcl::warnings {}} -result 0

test form-23.4 {gemeinsame Optionen gelten ueberall} -body {
    # -id, -init, -readonly, -required, -tooltip und die Aussehen-Optionen
    # stehen in keiner Typliste und duerfen nie gemeldet werden.
    set ::pdf4tcl::warnings {}
    mytest -file {addForm signature 0 0 100 20 -id s -readonly 1 -tooltip "x"} \
            {addForm checkbutton 0 30 15 15 -id t -required 1 -bgcolor {1 1 0}} {}
    file delete testdebug.pdf
    llength $::pdf4tcl::warnings
} -cleanup {set ::pdf4tcl::warnings {}} -result 0

test form-23.5 {das Feld entsteht trotzdem} -body {
    # Gemeldet, nicht abgelehnt -- der Aufruf laeuft durch.
    set ::pdf4tcl::warnings {}
    mytest -file {addForm text 0 0 100 20 -id a -value X} {}
    set res [pdf4tcl::getForms testdebug.pdf]
    file delete testdebug.pdf
    dict get $res a type
} -cleanup {set ::pdf4tcl::warnings {}} -result "/Tx"


# ---------------------------------------------------------------------------
# form-24.x  Ein Formular aus FREMDER Erzeugung (0.9.4.57)
#
# tests/fixtures/foreign-form.pdf stammt aus OpenOffice.org 3.4, nicht aus
# pdf4tcl. Bis hierher wurde getForms und fillForms nur gegen eigene
# Ausgabe geprueft -- und eigene Ausgabe trifft die eigenen Annahmen.
#
# Gleich der erste Versuch fand einen Fehler: OpenOffice schreibt fuer ein
# leeres Textfeld /V <FEFF>, eine leere UTF-16-Zeichenkette. FormSetKey
# kannte drei Muster (literale Zeichenkette, Name, Zahl), aber keines fuer
# eine HEX-Zeichenkette. Also galt der Schluessel als nicht vorhanden und
# ein zweites /V wurde angehaengt:
#
#   qpdf: dictionary has duplicated key /V; last occurrence overrides
#         earlier ones
#
# getForms las danach das aeltere, leere.
# ---------------------------------------------------------------------------

set ::foreignForm [file join $::pdf4tclTestRoot tests fixtures foreign-form.pdf]
testConstraint haveForeignForm [file exists $::foreignForm]

test form-24.1 {ein fremdes Formular laesst sich auslesen} \
        -constraints {haveForeignForm} -body {
    set f [pdf4tcl::getForms $::foreignForm]
    expr {[dict size $f] > 10
            && [dict exists $f {Given Name Text Box}]
            && [dict get $f {Given Name Text Box} type] eq "/Tx"}
} -result 1

test form-24.2 {ein Wert kommt zurueck, was hineinging} \
        -constraints {haveForeignForm} -body {
    # Der Fall, der den Fehler zeigte: das Feld traegt /V <FEFF>, und der
    # neue Wert muss das ERSETZEN, nicht danebengeschrieben werden.
    pdf4tcl::fillForms $::foreignForm ffout.pdf \
            {"Given Name Text Box" "Meier & Co (GmbH)"}
    set v [dict get [pdf4tcl::getForms ffout.pdf] {Given Name Text Box} value]
    file delete ffout.pdf
    set v
} -result {Meier & Co (GmbH)}

test form-24.3 {kein doppelter Schluessel} -constraints {haveForeignForm} -body {
    # Die Gegenprobe zu 24.2. Ohne sie wuerde der Test auch gruen, wenn
    # zwei /V dastuenden und zufaellig das richtige gewinnt.
    pdf4tcl::fillForms $::foreignForm ffout.pdf \
            {"Given Name Text Box" "Meier"}
    set fh [open ffout.pdf rb]
    set data [read $fh]
    close $fh
    file delete ffout.pdf
    # Objekt 5 ist das Feld; darin darf /V genau einmal vorkommen.
    regexp {\n5 0 obj(.*?)endobj} $data -> obj
    expr {[regexp -all {/V[\s(<]} $obj] == 1}
} -result 1

test form-24.4 {der Rundlauf haelt auch hier} -constraints {haveForeignForm} -body {
    pdf4tcl::fillForms $::foreignForm ff1.pdf \
            {"Given Name Text Box" "Meier & Co (GmbH)"}
    set quelle ff1.pdf
    foreach ziel {ff2.pdf ff3.pdf} {
        set alt [pdf4tcl::getForms $quelle]
        set neu {}
        dict for {k v} $alt {
            if {[string index [dict get $v value] 0] ne "/"} {
                dict set neu $k [dict get $v value]
            }
        }
        pdf4tcl::fillForms $quelle $ziel $neu
        set quelle $ziel
    }
    set v [dict get [pdf4tcl::getForms ff3.pdf] {Given Name Text Box} value]
    foreach f {ff1.pdf ff2.pdf ff3.pdf} { catch {file delete $f} }
    set v
} -result {Meier & Co (GmbH)}

# ---------------------------------------------------------------------------
# form-25.x  Was getForms und fillForms NICHT sehen (0.9.4.64)
#
# Diese drei Dateien sind von Hand gebaut (tests/fixtures/form-*.pdf), nicht
# heruntergeladen: eine Testdatei bleibt fuer immer im Repository, und eine,
# deren Herkunft oder Lizenz man erst klaeren muss, ist schlechter als gar
# keine.
#
# Sie halten den STAND fest, nicht ein Ziel. Alle drei Faelle liest pdf4tcl
# heute falsch oder gar nicht, und zwar STILL -- kein Fehler, keine Meldung,
# nur eine Auskunft, die nicht stimmt. Genau davor warnt der Kommentar zu
# form-24.x: eigene Ausgabe trifft die eigenen Annahmen.
#
# Wenn einer der Tests spaeter faellt, ist das die gute Nachricht: dann ist
# der Fall behoben, und die Erwartung gehoert nachgezogen.
# ---------------------------------------------------------------------------

set ::multiWidget [file join $::pdf4tclTestRoot tests fixtures form-multiwidget.pdf]
set ::nestedForm  [file join $::pdf4tclTestRoot tests fixtures form-nested.pdf]
set ::xfaForm     [file join $::pdf4tclTestRoot tests fixtures form-xfa.pdf]
testConstraint haveMultiWidget [file exists $::multiWidget]
testConstraint haveNestedForm  [file exists $::nestedForm]
testConstraint haveXfaForm     [file exists $::xfaForm]
set ::xfaDyn [file join $::pdf4tclTestRoot tests fixtures form-xfa-dynamic.pdf]
testConstraint haveXfaDyn      [file exists $::xfaDyn]
set ::xfaIso [file join $::pdf4tclTestRoot tests fixtures form-xfa-iso.pdf]
testConstraint haveXfaIso      [file exists $::xfaIso]

test form-25.1 {ein Feld mit zwei Widgets wird gefunden} \
        -constraints haveMultiWidget -body {
    # DER DURCHSCHLAGSATZ. Ein CMR-Frachtbrief hat ein Feld, das auf vier
    # Blaettern erscheint: EIN Feldobjekt mit /T und /V, darunter mehrere
    # Widgets mit eigenem /Rect und eigenem /AP (ISO 32000-1 12.7.4.1).
    #
    # Bis .63 wurde so ein Feld GAR NICHT gefunden -- getForms gab ein
    # leeres dict, fillForms meldete "no such field". Seit .64 laeuft
    # beides ueber den Feldbaum.
    #
    # "widgets" sagt, wieviele es sind. Ohne den Schluessel sagt getForms
    # ueber diesen Fall gar nichts.
    set f [pdf4tcl::getForms $::multiWidget]
    list [dict size $f] [dict exists $f kunde] \
         [dict get $f kunde widgets]
} -result {1 1 2}

test form-25.2 {und fillForms zeichnet in JEDEM Widget} \
        -constraints haveMultiWidget -body {
    # Jedes Widget hat sein eigenes /Rect und sein eigenes /AP -- beim
    # Durchschlagsatz vier verschiedene auf vier Blaettern. EIN Strom
    # fuer alle waere an drei Stellen falsch positioniert.
    set aus [makeFile {} mw-voll.pdf]
    set n [pdf4tcl::fillForms $::multiWidget $aus {kunde "Spedition Muster"}]
    set fh [open $aus rb] ; set d [read $fh] ; close $fh
    removeFile mw-voll.pdf
    list $n [regexp -all {\(Spedition Muster\) Tj} $d]
} -result {1 2}

test form-25.3 {ein verschachtelter Name kommt mit seinem Vater} \
        -constraints haveNestedForm -body {
    # Der volle Name eines Feldes setzt sich aus der /Parent-Kette
    # zusammen: /T am Vater "person", /T am Kind "city" ergibt
    # "person.city" (ISO 32000-1 12.7.3.2).
    #
    # Bis .63 kam nur "city" heraus. Das ist nicht bloss unschoen: in
    # einem Formular mit "rechnung.betrag" und "lieferung.betrag"
    # hiessen dann BEIDE Felder "betrag", und eines ueberschrieb das
    # andere im dict.
    dict keys [pdf4tcl::getForms $::nestedForm]
} -result person.city

test form-25.3a {und unter diesem Namen laesst es sich fuellen} \
        -constraints haveNestedForm -body {
    set aus [makeFile {} nested-voll.pdf]
    set n [pdf4tcl::fillForms $::nestedForm $aus {person.city "Vreden"}]
    set fh [open $aus rb] ; set d [read $fh] ; close $fh
    removeFile nested-voll.pdf
    list $n [expr {[string first "(Vreden) Tj" $d] >= 0}]
} -result {1 1}

test form-25.3b {rechtsbuendig bleibt rechtsbuendig} -body {
    # /Q 0 links, 1 mittig, 2 rechts (ISO 32000-1 12.7.4.3, Tabelle 228).
    # Bis .63 setzte der neu gebaute Strom immer "2 1.1 Td" -- die Option
    # gab es, und sie tat nichts. Gemessen: /Q 2 stand im Feld, der Text
    # stand links.
    #
    # Die Breite kommt aus den Metriken der Basisschrift. Bei einer
    # EINGEBETTETEN Fremdschrift gibt es sie beim Fuellen nicht; dann
    # bleibt es linksbuendig, denn eine geschaetzte Ausrichtung waere
    # falsch und saehe richtig aus.
    set leer [makeFile {} q-leer.pdf]
    set voll [makeFile {} q-voll.pdf]
    set p [pdf4tcl::new %AUTO% -paper a5]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 30 40 150 16 -id rechts -align right
    $p write -file $leer
    $p destroy
    pdf4tcl::fillForms $leer $voll {rechts "X"}
    set fh [open $voll rb] ; set d [read $fh] ; close $fh
    removeFile q-leer.pdf
    removeFile q-voll.pdf
    set tx 0
    regexp {([0-9.]+) [0-9.]+ Td \(X\) Tj} $d -> tx
    # Bei 150 Punkt Breite und einem schmalen "X" muss der Text weit
    # rechts stehen -- deutlich mehr als der linke Rand von 2.
    expr {$tx > 100}
} -result 1

test form-25.4 {ein HYBRIDES XFA-Formular wird weiter gefuellt} \
        -constraints haveXfaForm -body {
    # Hybrid: XFA UND gueltige AcroForm-Felder. Ein Betrachter ohne XFA
    # nimmt die AcroForm-Seite, /V wirkt -- also bleibt es beim Fuellen.
    # Eine pauschale Absage bei jedem /XFA waere hier falsch gewesen.
    set aus [makeFile {} xfa-voll.pdf]
    set rc [catch {pdf4tcl::fillForms $::xfaForm $aus {name "Muster"}} n]
    removeFile xfa-voll.pdf
    list $rc $n
} -result {0 1}

test form-25.6 {dynamisches XFA in der NORMGERECHTEN Lage} \
        -constraints haveXfaIso -body {
    # DER FALL, DER WIRKLICH VORKOMMT -- und den die erste Fassung nicht
    # traf.
    #
    # Die zwei Merkmale stehen an ZWEI Stellen:
    #   /NeedsRendering   Katalog     (ISO 32000-1 Tabelle 28)
    #   /XFA              /AcroForm   (Tabelle 218)
    # und /AcroForm liegt fast immer in einem EIGENEN Objekt -- pdf4tcl
    # selbst schreibt "/AcroForm 12 0 R".
    #
    # Der erste Anlauf suchte beide im Katalogkoerper und traf damit nur
    # eine Datei mit direkt eingebettetem AcroForm. form-25.5 blieb
    # gruen, weil seine Vorlage das Flag zum Katalog legt: ein Test, der
    # den Fall konstruiert, den der Code trifft, statt den, der
    # vorkommt. Gemeldet aus einer Durchsicht am 06.09.2026, nachgemessen
    # -- still durchgelaufen, n=1.
    set aus [makeFile {} xfaiso-voll.pdf]
    catch {pdf4tcl::fillForms $::xfaIso $aus {name "Muster"}} e
    removeFile xfaiso-voll.pdf
    list [string match "*dynamic XFA*" $e] [string match "*NeedsRendering*" $e]
} -result {1 1}

test form-25.5 {ein DYNAMISCHES XFA-Formular wird abgelehnt} \
        -constraints haveXfaDyn -body {
    # /NeedsRendering true (ISO 32000-1 12.7.8, Tabelle 28): die
    # AcroForm-Felder sind eine Attrappe, der Betrachter baut die Seiten
    # aus dem XML. Wer hier /V setzt, aendert am Sichtbaren nichts.
    #
    # Bis .63 lief das klaglos durch und meldete einen Erfolg, den es
    # nicht gab. Ein stiller Fehlschlag ist schlimmer als eine Absage --
    # und die Absage nennt den Grund, statt nur nein zu sagen.
    set aus [makeFile {} xfadyn-voll.pdf]
    catch {pdf4tcl::fillForms $::xfaDyn $aus {name "Muster"}} e
    removeFile xfadyn-voll.pdf
    list [string match "*dynamic XFA*" $e] \
         [string match "*NeedsRendering*" $e]
} -result {1 1}


::tcltest::cleanupTests