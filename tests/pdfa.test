    expr {[string first {<?xpacket end} $data] >= 0}
} -result 1

# ===========================================================================
# pdfa-6.x  Metadaten-Synchronisation
# ===========================================================================

test pdfa-6.1 {metadata: title in XMP for -pdfa} -body {
    set pdf [pdf4tcl::new %AUTO% -pdfa 1b]
    $pdf metadata -title "Testdokument"
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "test" -x 50 -y 700
    $pdf endPage
    set data [$pdf get]
    $pdf destroy
    expr {[string first {Testdokument} $data] >= 0}
} -result 1

test pdfa-6.2 {metadata: author in XMP for -pdfa} -body {
    set pdf [pdf4tcl::new %AUTO% -pdfa 1b]
    $pdf metadata -author "Max Mustermann"
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "test" -x 50 -y 700
    $pdf endPage
    set data [$pdf get]
    $pdf destroy
    expr {[string first {Max Mustermann} $data] >= 0}
} -result 1

# ===========================================================================
# pdfa-7.x  Binary-Comment (ISO 19005-1 SS6.1.7)
# ===========================================================================

test pdfa-7.1 {binary comment: present for -pdfa 1b} -body {
    set data [make_pdfa 1b]
    # Pruefen ob Bytes >= 0x80 nach dem Header vorhanden
    set idx [string first "%PDF-" $data]
    set line2start [string first "\n" $data $idx]
    set line2end [string first "\n" $data [expr {$line2start+1}]]
    set comment [string range $data [expr {$line2start+1}] $line2end]
    # Muss mit % anfangen und mind. 4 high bytes enthalten
    expr {[string index $comment 0] eq "%" && [string length $comment] >= 5}
} -result 1

# ===========================================================================
# pdfa-8.x  Mehrere Seiten
# ===========================================================================

test pdfa-8.1 {-pdfa 1b: multiple pages work} -body {
    set pdf [pdf4tcl::new %AUTO% -pdfa 1b]
    for {set i 1} {$i <= 3} {incr i} {
        $pdf startPage
        $pdf setFont 10 Helvetica
        $pdf text "Seite $i" -x 50 -y 700
        $pdf endPage
    }
    set data [$pdf get]
    $pdf destroy
    # Alle 3 Seiten und kein /Group auf Seiten
    expr {[string first {/Count 3} $data] >= 0 && \
          [string first {/Group} $data] < 0}
} -result 1

test pdfa-8.2 {-pdfa 2b: multiple pages work} -body {
    set pdf [pdf4tcl::new %AUTO% -pdfa 2b]
    for {set i 1} {$i <= 3} {incr i} {
        $pdf startPage
        $pdf setFont 10 Helvetica
        $pdf text "Seite $i" -x 50 -y 700
        $pdf endPage
    }
    set data [$pdf get]
    $pdf destroy
    expr {[string first {/Count 3} $data] >= 0}
} -result 1


# pdfa-9.x  ICC-Profil Kompression (0.9.4.21)
# Kein echtes ICC-Profil im Test-Environment noetig:
# Wir mocken _WriteOutputIntent indem wir ein tmp-Profil erzeugen.

test pdfa-9.1 {ICC-Profil: FlateDecode bei -compress 1} -setup {
    set iccfile [makeFile [string repeat "ICCP" 512] test_icc.icc]
} -body {
    set pdf [pdf4tcl::new %AUTO% -pdfa 1b -compress 1 -pdfa-icc $iccfile]
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "ICC Test" -x 50 -y 700
    $pdf endPage
    set data [$pdf get]
    $pdf destroy
    # FlateDecode muss im Stream mit /N 3 vorkommen
    regexp {/N 3[^\>]*FlateDecode|FlateDecode[^\>]*/N 3} $data
} -cleanup {
    removeFile test_icc.icc
} -result 1

test pdfa-9.2 {ICC-Profil: kein FlateDecode bei -compress 0} -setup {
    set iccfile [makeFile [string repeat "ICCP" 512] test_icc2.icc]
} -body {
    set pdf [pdf4tcl::new %AUTO% -pdfa 1b -compress 0 -pdfa-icc $iccfile]
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "ICC Test" -x 50 -y 700
    $pdf endPage
    set data [$pdf get]
    $pdf destroy
    # Kein FlateDecode -- raw
    expr {![regexp {FlateDecode} $data]}
} -cleanup {
    removeFile test_icc2.icc
} -result 1

test pdfa-9.3 {ICC-Profil: komprimiertes PDF kleiner als unkomprimiertes} -setup {
    set iccfile [makeFile [string repeat "ICCP" 1024] test_icc3.icc]
} -body {
    set pdfc [pdf4tcl::new %AUTO% -pdfa 1b -compress 1 -pdfa-icc $iccfile]
    $pdfc startPage; $pdfc setFont 10 Helvetica; $pdfc text "X" -x 50 -y 700
    $pdfc endPage
    set datac [$pdfc get]; $pdfc destroy

    set pdfu [pdf4tcl::new %AUTO% -pdfa 1b -compress 0 -pdfa-icc $iccfile]
    $pdfu startPage; $pdfu setFont 10 Helvetica; $pdfu text "X" -x 50 -y 700
    $pdfu endPage
    set datau [$pdfu get]; $pdfu destroy

    expr {[string length $datac] < [string length $datau]}
} -cleanup {
    removeFile test_icc3.icc
} -result 1

# Aufraumen
proc contains {str sub} {
    expr {[string first $sub $str] >= 0}
}

# -----------------------------------------------------------------------
# Conformance level A (0.9.4.41)
# -----------------------------------------------------------------------
# Level A adds tagged PDF, a natural language and Unicode mappings on top of
# level B. The first two are checked when the document is finished, because
# -pdfa 3a is a claim: it writes pdfaid:conformance A into the XMP packet and
# a reader trusts that.

test pdfa-a-1.1 {the a levels are accepted} -body {
    set res {}
    foreach lvl {1a 2a 3a} {
        lappend res [catch {[::pdf4tcl::new %AUTO% -pdfa $lvl] destroy}]
    }
    set res
} -result {0 0 0}

test pdfa-a-1.2 {an unknown level is still refused} -body {
    set res [catch {::pdf4tcl::new %AUTO% -pdfa 4x} err]
    list $res [string match "*invalid -pdfa value*" $err]
} -result {1 1}

test pdfa-a-1.3 {level a without tagging is refused} -body {
    set p [::pdf4tcl::new %AUTO% -pdfa 3a]
    $p startPage
    $p setFont 12 Helvetica
    $p text "x" -x 50 -y 50
    set res [catch {$p get} err]
    catch {$p destroy}
    list $res [string match "*requires tagged PDF*" $err]
} -result {1 1}

test pdfa-a-1.4 {level a without a language is refused} -body {
    set p [::pdf4tcl::new %AUTO% -pdfa 3a]
    $p tagged 1
    $p startPage
    $p setFont 12 Helvetica
    $p tagText P "x" -x 50 -y 50
    set res [catch {$p get} err]
    catch {$p destroy}
    list $res [string match "*requires a document language*" $err]
} -result {1 1}

test pdfa-a-1.5 {a tagged document with a language passes} -body {
    set p [::pdf4tcl::new %AUTO% -pdfa 3a -compress 0]
    $p tagged 1 -lang de-DE
    $p startPage
    $p setFont 12 Helvetica
    $p tagText P "x" -x 50 -y 50
    set data [$p get]
    $p destroy
    list [contains $data "<pdfaid:part>3</pdfaid:part>"] \
            [contains $data "<pdfaid:conformance>A</pdfaid:conformance>"] \
            [contains $data "/StructTreeRoot"] \
            [contains $data "/Lang (de-DE)"]
} -result {1 1 1 1}

test pdfa-a-1.6 {level b is unaffected by the check} -body {
    set p [::pdf4tcl::new %AUTO% -pdfa 3b]
    $p startPage
    $p setFont 12 Helvetica
    $p text "x" -x 50 -y 50
    set res [catch {$p get}]
    $p destroy
    set res
} -result 0

# -----------------------------------------------------------------------
# Fonts that cannot be embedded (0.9.4.41)
# -----------------------------------------------------------------------

test pdfa-font-1.1 {a standard font with -pdfa is reported} -body {
    # PDF/A requires every font program to be embedded and the 14 standard
    # fonts have none. The file is still produced -- it is a valid PDF, just
    # not a valid PDF/A -- but it used to happen without a word.
    set ::pdf4tcl::warnings {}
    set p [::pdf4tcl::new %AUTO% -pdfa 3b]
    $p startPage
    $p setFont 12 Helvetica
    $p text "x" -x 50 -y 50
    $p get
    $p destroy
    list [llength $::pdf4tcl::warnings] \
            [string match "*no embeddable font program*" \
                    [lindex $::pdf4tcl::warnings 0]]
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result {1 1}

test pdfa-font-1.2 {reported once, not per font} -body {
    set ::pdf4tcl::warnings {}
    set p [::pdf4tcl::new %AUTO% -pdfa 3b]
    $p startPage
    foreach f {Helvetica Times-Roman Courier} {
        $p setFont 12 $f
        $p text "x" -x 50 -y 50
    }
    $p get
    $p destroy
    llength $::pdf4tcl::warnings
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result 1

test pdfa-font-1.3 {without -pdfa nothing is reported} -body {
    set ::pdf4tcl::warnings {}
    set p [::pdf4tcl::new %AUTO%]
    $p startPage
    $p setFont 12 Helvetica
    $p text "x" -x 50 -y 50
    $p get
    $p destroy
    llength $::pdf4tcl::warnings
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result 0

# -----------------------------------------------------------------------
# PDF/A and PDF/UA in one document (0.9.4.41)
# -----------------------------------------------------------------------
# PDF/A clause 6.6.2.3.1 requires every XMP property outside the predefined
# schemas to be declared through pdfaExtension. Without that declaration
# veraPDF rejects a PDF/A file over pdfuaid:part, so a document could not be
# archivable and accessible at the same time -- which is exactly the
# combination that gets asked for.

test pdfa-ua-1.1 {pdfuaid gets an extension schema when -pdfa is set} -body {
    set p [::pdf4tcl::new %AUTO% -pdfa 3a -compress 0]
    $p tagged 1 -lang de-DE -ua 1
    $p startPage
    $p setFont 12 Helvetica
    $p tagText P "x" -x 50 -y 50
    set data [$p get]
    $p destroy
    list [contains $data "<pdfuaid:part>1</pdfuaid:part>"] \
            [contains $data "PDF/UA Universal Accessibility Schema"] \
            [contains $data "http://www.aiim.org/pdfua/ns/id/"] \
            [contains $data "<pdfaProperty:valueType>Integer</pdfaProperty:valueType>"]
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result {1 1 1 1}

test pdfa-ua-1.2 {without -pdfa there is no extension schema} -body {
    # The declaration is a PDF/A requirement. A plain PDF/UA document does
    # not need it, and adding it would be noise.
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p tagged 1 -lang de-DE -ua 1
    $p startPage
    $p setFont 12 Helvetica
    $p tagText P "x" -x 50 -y 50
    set data [$p get]
    $p destroy
    list [contains $data "<pdfuaid:part>1</pdfuaid:part>"] \
            [contains $data "PDF/UA Universal Accessibility Schema"]
} -result {1 0}

test pdfa-ua-1.3 {without -ua there is no pdfuaid and no schema} -body {
    set p [::pdf4tcl::new %AUTO% -pdfa 3a -compress 0]
    $p tagged 1 -lang de-DE
    $p startPage
    $p setFont 12 Helvetica
    $p tagText P "x" -x 50 -y 50
    set data [$p get]
    $p destroy
    list [contains $data "pdfuaid"] \
            [contains $data "PDF/UA Universal Accessibility Schema"]
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result {0 0}

test pdfa-ua-1.4 {Factur-X and PDF/UA share one extension schema block} -body {
    # XMP allows pdfaExtension:schemas once. Emitting a second block made
    # veraPDF stop before validating anything: "Duplicate property or field
    # node 'pdfaExtension:schemas'". Two namespaces need declaring here --
    # fx: and pdfuaid: -- so both go into one rdf:Bag.
    set p [::pdf4tcl::new %AUTO% -pdfa 3a -compress 0]
    $p tagged 1 -lang de-DE -ua 1
    $p startPage
    $p setFont 12 Helvetica
    $p tagText P "x" -x 50 -y 50
    $p endPage
    $p facturx -contents "<x/>"
    set data [$p get]
    $p destroy
    set n 0
    foreach _ [regexp -all -inline {<pdfaExtension:schemas>} $data] { incr n }
    list $n \
            [contains $data "Factur-X PDFA Extension Schema"] \
            [contains $data "PDF/UA Universal Accessibility Schema"]
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result {1 1 1}

test pdfa-ua-1.5 {Factur-X alone declares only its own namespace} -body {
    set p [::pdf4tcl::new %AUTO% -pdfa 3b -compress 0]
    $p startPage
    $p setFont 12 Helvetica
    $p text "x" -x 50 -y 50
    $p endPage
    $p facturx -contents "<x/>"
    set data [$p get]
    $p destroy
    list [contains $data "Factur-X PDFA Extension Schema"] \
            [contains $data "PDF/UA Universal Accessibility Schema"]
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result {1 0}

test pdfa-font-1.4 {a PDF/UA claim warns about standard fonts too} -body {
    # ISO 14289-1 clause 7.21.4.1 requires embedded font programs just as
    # PDF/A does. The warning used to fire only for -pdfa, so a tagged form
    # claiming UA failed validation on a point pdf4tcl already knew about.
    set ::pdf4tcl::warnings {}
    set p [::pdf4tcl::new %AUTO%]
    $p tagged 1 -lang de-DE -ua 1
    $p startPage
    $p setFont 12 Helvetica
    $p tagText P "x" -x 50 -y 50
    $p get
    $p destroy
    list [llength $::pdf4tcl::warnings] \
            [string match "PDF/UA:*no embeddable font program*" \
                    [lindex $::pdf4tcl::warnings 0]]
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result {1 1}

test pdfa-font-1.5 {tagging without a UA claim stays quiet} -body {
    # Tagging alone claims nothing, so a base-14 font is a legitimate choice.
    set ::pdf4tcl::warnings {}
    set p [::pdf4tcl::new %AUTO%]
    $p tagged 1 -lang de-DE
    $p startPage
    $p setFont 12 Helvetica
    $p tagText P "x" -x 50 -y 50
    $p get
    $p destroy
    llength $::pdf4tcl::warnings
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result 0

# -----------------------------------------------------------------------
# Vector marks for check boxes and radio buttons (0.9.4.42)
# -----------------------------------------------------------------------
# A ZapfDingbats glyph cannot be embedded, and both PDF/A and PDF/UA require
# every font program to be embedded, so a check box used to make a document
# non-conformant no matter what else was right. -markstyle auto draws the
# mark with lines and curves where a conformance is claimed, and leaves
# every other document looking exactly as before.

proc markProbe {newArgs {tagArgs {}}} {
    set p [::pdf4tcl::new %AUTO% -compress 0 {*}$newArgs]
    if {[llength $tagArgs]} {
        $p tagged {*}$tagArgs
    }
    $p startPage
    $p setFont 10 Helvetica
    if {[llength $tagArgs]} {
        $p tagBegin P ; $p text "x" -x 20 -y 20 ; $p tagEnd
    }
    $p addForm checkbutton 50 50 16 16 -id c
    $p addForm radiobutton 50 80 16 16 -id r -group g -value a
    set data [$p get]
    $p destroy
    return [contains $data "ZapfDingbats"]
}

test mark-1.1 {without a claim the glyph is kept} -body {
    # The important half: existing documents must not change appearance.
    markProbe {}
} -result 1

test mark-1.2 {a PDF/UA claim switches to vector marks} -body {
    markProbe {} {1 -lang de-DE -ua 1}
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result 0

test mark-1.3 {conformance level A switches too} -body {
    markProbe {-pdfa 3a} {1 -lang de-DE}
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result 0

test mark-1.4 {level B uses the vector mark too} -body {
    # Hier stand die Annahme, die Glyphe sei nicht das, was eine
    # B-Datei durchfallen laesst. Gemessen mit veraPDF 1.30.2 an einem
    # Dokument, dessen einziges Formularfeld eine Checkbox ist:
    #
    #   mit Glyphe:  -pdfa 1b, 2b, 3b -> alle FAIL, Klausel 6.2.11.4.1
    #   mit Vektor:  -pdfa 1b, 2b, 3b -> alle PASS
    #
    # Die verletzte Regel ist "das Fontprogramm ist nicht eingebettet",
    # und die kennt keine Stufen -- ZapfDingbats gehoert zu den
    # Standard-14 und hat keins. Das Dokument war also schon beim
    # ERZEUGEN unkonform, bevor jemand etwas ausgefuellt hat.
    markProbe {-pdfa 3b}
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result 0

test mark-1.5 {-markstyle font overrides the claim} -body {
    markProbe {-markstyle font} {1 -lang de-DE -ua 1}
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result 1

test mark-1.6 {-markstyle vector works without any claim} -body {
    markProbe {-markstyle vector}
} -result 0

test mark-1.7 {an unknown -markstyle is refused} -body {
    set res [catch {::pdf4tcl::new %AUTO% -markstyle dingbat} err]
    list $res [string match "*invalid -markstyle value*" $err]
} -result {1 1}

test mark-1.8 {the vector check mark is actually drawn} -body {
    set p [::pdf4tcl::new %AUTO% -compress 0 -markstyle vector]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm checkbutton 50 50 16 16 -id c
    set data [$p get]
    $p destroy
    # two line segments and a stroke, no text operator
    list [contains $data " l "] [contains $data " S "] \
            [contains $data "/ZaDb"]
} -result {1 1 0}

# -----------------------------------------------------------------------
# Appearance dictionaries on form fields (0.9.4.42)
# -----------------------------------------------------------------------
# ISO 19005 clause 6.3.3 wants an appearance dictionary on every annotation,
# widgets included, and allows only /N in it. Both were wrong: a text field
# carried no /AP at all -- _BuildTextAP produced the stream but nobody
# referenced it -- and a check box wrote /D beside /N. A reader builds the
# look from /DA and /V either way, which is why it went unnoticed until
# PDF/A asked.

test pdfa-ap-1.0 {no appearance reference is left dangling} -body {
    # The first attempt tested [info exists onid] rather than its value.
    # _BuildTextAP returns the empty string for a field without an initial
    # value, so the file got "/AP << /N  0 R >>" -- not a valid dictionary.
    # qpdf, pypdf and check-tagged.py all accepted it; veraPDF refused to
    # parse the object. Hence this test looks at the bytes.
    set p [::pdf4tcl::new %AUTO% -compress 0 -pdfa 3b]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 50 120 16 -id empty
    $p addForm text 50 80 120 16 -id filled -init "Wert"
    $p addForm checkbutton 50 110 16 16 -id c
    set data [$p get]
    $p destroy
    # every "N <ref>" must name a real object number
    set bad 0
    foreach {- ref} [regexp -all -inline {/N\s+(\S*)\s+0 R} $data] {
        if {![string is integer -strict $ref]} { incr bad }
    }
    set bad
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result 0

test pdfa-ap-1.1 {a text field carries /AP with /N under -pdfa} -body {
    set p [::pdf4tcl::new %AUTO% -compress 0 -pdfa 3b]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm text 50 50 120 16 -id t
    set data [$p get]
    $p destroy
    contains $data "/AP << /N "
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result 1

test pdfa-ap-1.2 {a check box writes no /D under -pdfa} -body {
    set p [::pdf4tcl::new %AUTO% -compress 0 -pdfa 3b]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm checkbutton 50 50 16 16 -id c
    set data [$p get]
    $p destroy
    list [contains $data "/N << /Yes"] [contains $data "/D << /Yes"]
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result {1 0}

test pdfa-ap-1.3 {without -pdfa the /D appearance is kept} -body {
    # /D is the pressed look. No reader needs it, but removing it everywhere
    # would change files that were perfectly fine.
    set p [::pdf4tcl::new %AUTO% -compress 0]
    $p startPage
    $p setFont 10 Helvetica
    $p addForm checkbutton 50 50 16 16 -id c
    set data [$p get]
    $p destroy
    contains $data "/D << /Yes"
} -result 1


# ===========================================================================
# pdfa-xrefstream-x  Der xref-Stream beschreibt sich selbst
#
# ISO 32000-1 Klausel 7.5.8.2: der Stream ist ein Objekt wie jedes andere
# und gehoert in seine eigene Tabelle.
#
# Bis 0.9.4.49 wurde /Size bestimmt, BEVOR das Stream-Objekt seine Nummer
# bekam. Eine Datei mit den Objekten 1..15 sagte "/Size 15", der Stream
# beschrieb also 0..14 -- er selbst fehlte.
#
# Weder qpdf --check noch veraPDF haben das gemeldet; die Leser sind
# tolerant genug. Deshalb hier ein Test, der nachrechnet.
# ===========================================================================

proc xrefStreamPdf {} {
    set pdf [pdf4tcl::new %AUTO% -paper a4 -pdfa 2b -compress 0]
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "xref stream" -x 50 -y 700
    $pdf endPage
    set data [$pdf get]
    $pdf destroy
    return $data
}

test pdfa-xrefstream-1 {PDF/A-2b schreibt einen xref-Stream} -body {
    # PDF/A-1 verbietet die Form, PDF/A-2 verlangt sie -- ohne Stream
    # messen die folgenden Tests nichts.
    set data [xrefStreamPdf]
    expr {[regexp {/Type\s*/XRef} $data] > 0}
} -result 1

test pdfa-xrefstream-2 {/Size zaehlt das Stream-Objekt mit} -body {
    set data [xrefStreamPdf]
    regexp {/Size\s+(\d+)} $data -> size
    # Die hoechste vergebene Objektnummer.
    set maxOid 0
    foreach {full n} [regexp -all -inline {(?:^|\n)(\d+)\s+0\s+obj} $data] {
        if {$n > $maxOid} { set maxOid $n }
    }
    # /Size ist die ANZAHL, also hoechste Nummer plus eins.
    expr {$size == $maxOid + 1}
} -result 1

test pdfa-xrefstream-3 {/Index deckt denselben Bereich ab} -body {
    set data [xrefStreamPdf]
    regexp {/Size\s+(\d+)} $data -> size
    regexp {/Index\s*\[\s*0\s+(\d+)\s*\]} $data -> idx
    expr {$idx == $size}
} -result 1

test pdfa-xrefstream-4 {der eigene Eintrag zeigt auf das Stream-Objekt} -body {
    # Der eigentliche Nachweis: Zeile N der Tabelle muss auf "N 0 obj"
    # zeigen, wo N die Nummer des Stream-Objekts ist. Ein Eintrag mit
    # Offset 0 waere die stille Variante des alten Fehlers.
    set data [xrefStreamPdf]
    regexp {/Size\s+(\d+)} $data -> size
    set xrefOid [expr {$size - 1}]

    # Unkomprimiert (-compress 0), also liegen die Bytes direkt da.
    set p [string first "/Type /XRef" $data]
    set sp [string first "stream" $data $p]
    set hdr [string range $data $p [expr {$sp - 1}]]
    regexp {/Length\s+(\d+)} $hdr -> len
    set b [expr {$sp + 6}]
    if {[string index $data $b] eq "\r"} { incr b }
    if {[string index $data $b] eq "\n"} { incr b }
    set plain [string range $data $b [expr {$b + $len - 1}]]

    # /W [1 4 2] -- sieben Bytes je Zeile.
    binary scan $plain cu* by
    set off 0
    for {set i 1} {$i < 5} {incr i} {
        set off [expr {$off * 256 + [lindex $by [expr {$xrefOid * 7 + $i}]]}]
    }
    string match "$xrefOid 0 obj*" [string range $data $off [expr {$off + 20}]]
} -result 1


test pdfa-xobject-1 {ein XObject nennt seine Resources} -body {
    # ISO 19005-2 Klausel 6.2.2: ein Inhaltsstrom, der Schriften oder
    # Bilder benutzt, braucht ein ausdruecklich zugeordnetes
    # Resources-Woerterbuch.
    #
    # Bis 0.9.4.50 wurde es nur bei -noimage geschrieben. Eine
    # PDF/A-3a-Datei mit getaggtem XObject bestand PDF/UA-1 und fiel bei
    # 3a allein daran durch.
    set pdf [pdf4tcl::new %AUTO% -paper a4 -pdfa 3b -compress 0]
    set xo [$pdf startXObject -paper a4]
    $pdf setFont 10 Helvetica
    $pdf text "im XObject" -x 10 -y 20
    $pdf endXObject
    $pdf startPage
    $pdf putImage $xo 0 0
    set data [$pdf get]
    $pdf destroy

    # Das XObject-Woerterbuch selbst, nicht das der Seite.
    regexp {/Type /XObject.*?>>} $data teil
    expr {[string first "/Resources" $teil] >= 0}
} -result 1

# ---------------------------------------------------------------------------
# pdfa-enc-x  PDF/A und Verschluesselung schliessen einander aus
# ---------------------------------------------------------------------------

test pdfa-enc-1 {-pdfa zusammen mit einem Passwort wird abgelehnt} -body {
    # ISO 19005 Klausel 6.1.3, in jedem Teil gleichlautend: "The Encrypt
    # key shall not be present in the trailer dictionary". Keine Stufe,
    # keine Ausnahme.
    #
    # Bis 0.9.4.54 ging es durch, und die Datei trug ihre
    # pdfaid-Behauptung neben einem /Encrypt. veraPDF meldete dann
    # "appears to be an encrypted PDF file and could not be processed" --
    # der Pruefer kommt nicht einmal dazu, die Behauptung zu widerlegen.
    set p [pdf4tcl::new %AUTO% -paper a5 -pdfa 3b -userpassword geheim]
    $p startPage
    set rc [catch {$p get} e]
    catch {$p destroy}
    list $rc [string match {*clause 6.1.3*} $e]
} -result {1 1}

test pdfa-enc-2 {einzeln bleibt beides erlaubt} -body {
    # Gegenprobe: die Pruefung darf nur greifen, wenn beides zusammen
    # verlangt wird.
    set r {}
    set p [pdf4tcl::new %AUTO% -paper a5 -pdfa 3b]
    $p startPage
    lappend r [catch {$p get}]
    catch {$p destroy}
    set q [pdf4tcl::new %AUTO% -paper a5 -userpassword geheim]
    $q startPage
    lappend r [catch {$q get}]
    catch {$q destroy}
    set r
} -result {0 0}

test pdfa-6.10 {pdf:Producer nennt Programm und Version} -body {
    # pdf:Producer ist vom Typ AgentName (XMP Part 2, Tabelle 30), und
    # dafuer empfiehlt Part 1 Klausel 8.2.2.1 die Form
    #   Organisation Programmname Version
    # Vorher stand dort nur "pdf4tcl" -- ohne die Angabe, die man bei
    # einer fremden Datei als erstes sucht.
    set data [make_pdfa 2b]
    regexp {<pdf:Producer>([^<]*)</pdf:Producer>} $data -> wert
    expr {[string match "*pdf4tcl*" $wert]
            && [string match "*[package provide pdf4tcl]*" $wert]}
} -result 1

test pdfa-6.11 {-producer ueberschreibt die Vorgabe} -body {
    # Die Hoheit liegt beim Werkzeug (XMP Part 2, Abschnitt 4.9), aber
    # wer pdf4tcl einbettet, ist selbst das Werkzeug.
    set pdf [pdf4tcl::new %AUTO% -pdfa 2b]
    $pdf metadata -producer "Musterfirma Rechnungsdruck 2.1"
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "x" -x 50 -y 700
    set data [$pdf get]
    $pdf destroy
    regexp {<pdf:Producer>([^<]*)</pdf:Producer>} $data -> wert
    set wert
} -result "Musterfirma Rechnungsdruck 2.1"

test pdfa-6.12 {xmp:MetadataDate wird neben ModifyDate geschrieben} -body {
    # "Wann zuletzt IRGENDWELCHE Metadaten geaendert wurden" (XMP Part 1,
    # Tabelle 5), im Unterschied zu ModifyDate fuer den Inhalt. Muss
    # gleich oder spaeter als ModifyDate sein.
    set pdf [pdf4tcl::new %AUTO% -pdfa 2b]
    set jetzt [clock seconds]
    $pdf metadata -moddate $jetzt -creationdate $jetzt
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "x" -x 50 -y 700
    set data [$pdf get]
    $pdf destroy
    regexp {<xmp:ModifyDate>([^<]*)<} $data -> mod
    regexp {<xmp:MetadataDate>([^<]*)<} $data -> meta
    expr {$meta ne "" && $meta eq $mod}
} -result 1

test pdfa-6.13 {ohne ModifyDate auch kein MetadataDate} -body {
    # Gegenprobe: ein Datum zu erfinden, das niemand gesetzt hat, waere
    # schlechter als keines.
    set data [make_pdfa 2b]
    expr {[string first "xmp:MetadataDate" $data] < 0}
} -result 1

test mark-1.6 {ohne -pdfa bleibt die Glyphe} -body {
    # Gegenprobe: die Aenderung darf nur Dokumente betreffen, die einen
    # Anspruch erheben. Wer keinen erhebt, behaelt das Aussehen, das er
    # immer hatte.
    markProbe {}
} -cleanup {
    set ::pdf4tcl::warnings {}
} -result 1

test pdfa-7.1 {der Katalog fuehrt /Version als NAME} -body {
    # ISO 32000 Klausel 7.7.2 gibt fuer diesen Eintrag den Typ "name" an.
    # pdf4tcl schrieb eine Zahl -- in jeder Datei ueber Version 1.4, also
    # in aller PDF/A-2- und -3-Ausgabe, seit es diese Stufen gibt.
    #
    # Die Dateien blieben lesbar; ein Leser, der die Version aus dem
    # Katalog nimmt statt aus dem Kopf, bekam den falschen Typ.
    set data [make_pdfa 2b]
    expr {[regexp {/Version\s+/1\.7\M} $data] > 0}
} -result 1

test pdfa-7.2 {unter 1.5 steht gar kein /Version} -body {
    # Gegenprobe: der Eintrag ist optional und wird nur gesetzt, wo die
    # Kopfzeile nicht ausreicht.
    set pdf [pdf4tcl::new %AUTO%]
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "x" -x 50 -y 700
    set data [$pdf get]
    $pdf destroy
    expr {[string first "/Version" $data] < 0}
} -result 1


# ---------------------------------------------------------------------------
# pdfa-u-x  Stufe U (0.9.4.56)
#
# ISO 19005-2 Klausel 5.4: eine Datei der Stufe U erfuellt alle
# Anforderungen ausser denen von 6.7, waehrend Stufe B zusaetzlich 6.2.11.7
# auslaesst. U ist also genau B plus jene eine Klausel, A ist U plus die
# logische Struktur.
#
# Klausel 5.4 Anmerkung 3: Stufe U gibt es erst ab Teil 2 -- ein "1u"
# existiert nicht.
# ---------------------------------------------------------------------------

test pdfa-u-1.1 {2u und 3u werden angenommen} -body {
    set res {}
    foreach st {2u 3u} {
        lappend res [catch {[::pdf4tcl::new %AUTO% -pdfa $st] destroy}]
    }
    set res
} -result {0 0}

test pdfa-u-1.2 {1u gibt es nicht} -body {
    # Anmerkung 3 der Klausel sagt es ausdruecklich: Stufe U wurde mit
    # Teil 2 eingefuehrt und hat in Teil 1 kein Gegenstueck.
    catch {::pdf4tcl::new %AUTO% -pdfa 1u} e
    expr {[string match {*invalid -pdfa value*} $e]}
} -result 1

test pdfa-u-1.3 {pdfaid:conformance ist U} -body {
    set data [make_pdfa 3u]
    expr {[regexp {<pdfaid:conformance>U</pdfaid:conformance>} $data]
            && [regexp {<pdfaid:part>3</pdfaid:part>} $data]}
} -result 1

test pdfa-u-1.4 {2u nennt Teil 2} -body {
    # Gegenprobe: die Stufe darf den Teil nicht ueberschreiben.
    set data [make_pdfa 2u]
    expr {[regexp {<pdfaid:part>2</pdfaid:part>} $data]
            && [regexp {<pdfaid:conformance>U</pdfaid:conformance>} $data]}
} -result 1

test pdfa-u-1.5 {B bleibt B} -body {
    # Gegenprobe zur Gegenprobe: die Aenderung darf die vorhandenen
    # Stufen nicht anfassen.
    set data [make_pdfa 3b]
    regexp {<pdfaid:conformance>B</pdfaid:conformance>} $data
} -result 1


# ---------------------------------------------------------------------------
# pdfa-af-x  AFRelationship bei Anhaengen (0.9.4.56)
#
# ISO 19005-3 Klausel 6.8 verweist auf Anhang E: ein eingebetteter File,
# der die zusaetzlichen Anforderungen erfuellt, ist eine "associated file"
# und braucht ein /AFRelationship, das die Beziehung zum Dokument nennt.
#
# Ohne eines faellt die Datei bei veraPDF an Klausel 6.8 durch -- ein
# PDF/A-3-Dokument also, das keines ist. Die Vorgabe war leer.
# ---------------------------------------------------------------------------

test pdfa-af-1.1 {ohne Angabe steht Unspecified} -body {
    set pdf [pdf4tcl::new %AUTO% -paper a4 -pdfa 3b -compress 0]
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "x" -x 50 -y 700
    $pdf addEmbeddedFile [info script] -mimetype text/plain
    set data [$pdf get]
    $pdf destroy
    regexp {/AFRelationship\s*/Unspecified\M} $data
} -result 1

test pdfa-af-1.2 {eine Angabe wird uebernommen} -body {
    # Gegenprobe: die Vorgabe darf nicht ueberschreiben, was der
    # Aufrufer sagt.
    set pdf [pdf4tcl::new %AUTO% -paper a4 -pdfa 3b -compress 0]
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "x" -x 50 -y 700
    $pdf addEmbeddedFile [info script] -mimetype text/plain \
            -afrelationship Data
    set data [$pdf get]
    $pdf destroy
    expr {[regexp {/AFRelationship\s*/Data\M} $data]
            && ![regexp {/AFRelationship\s*/Unspecified\M} $data]}
} -result 1

test pdfa-af-1.3 {F, UF und Desc sind da} -body {
    # Klausel 6.8: das Dateispezifikations-Woerterbuch MUSS F und UF
    # fuehren und SOLLTE Desc fuehren. Anmerkung 3 sagt, warum beide:
    # UF fuer Plattform- und Sprachunabhaengigkeit, F fuer
    # Rueckwaertsvertraeglichkeit.
    set pdf [pdf4tcl::new %AUTO% -paper a4 -pdfa 3b -compress 0]
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "x" -x 50 -y 700
    $pdf addEmbeddedFile [info script] -mimetype text/plain \
            -description "Der Test selbst"
    set data [$pdf get]
    $pdf destroy
    expr {[regexp {/F\s*\(} $data] && [regexp {/UF\s*\(} $data]
            && [regexp {/Desc\s*\(Der Test selbst\)} $data]}
} -result 1


# ---------------------------------------------------------------------------
# pdfa-cw-x  Der Kreuzverweis /Info gegen XMP (0.9.4.56)
#
# ISO 19005-3 Tabelle 7 listet acht Paare. Klausel 6.6.3 sagt "should",
# nicht "shall" -- eine Datei ist also nie unGUELTIG dafuer. Sie ist nur
# widerspruechlich, und genau das soll der Kreuzverweis verhindern.
# ---------------------------------------------------------------------------

test pdfa-cw-1.1 {alle acht Paare, wenn der Aufrufer sie setzt} -body {
    set pdf [pdf4tcl::new %AUTO% -paper a4 -pdfa 3b -compress 0]
    set n [clock seconds]
    $pdf metadata -title "T" -author "A" -subject "S" -keywords "K" \
            -creator "C" -producer "P" -creationdate $n -moddate $n
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "x" -x 50 -y 700
    set data [$pdf get]
    $pdf destroy

    set fehlt {}
    foreach {info xmp} {
        Title        dc:title
        Author       dc:creator
        Subject      dc:description
        Keywords     pdf:Keywords
        Creator      xmp:CreatorTool
        Producer     pdf:Producer
        CreationDate xmp:CreateDate
        ModDate      xmp:ModifyDate
    } {
        if {[string first "/$info (" $data] < 0} { lappend fehlt "Info/$info" }
        if {[string first "<$xmp>" $data] < 0} { lappend fehlt "XMP/$xmp" }
    }
    set fehlt
} -result {}

test pdfa-cw-1.2 {Producer steht auf beiden Seiten, ungefragt} -body {
    # pdf4tcl schreibt pdf:Producer von sich aus. Stand er nicht auch im
    # Info-Dict, widersprachen sich die beiden Seiten des Kreuzverweises:
    # XMP nannte die Fassung, /Info nannte nichts.
    set pdf [pdf4tcl::new %AUTO% -paper a4 -pdfa 3b -compress 0]
    $pdf metadata -title "Nur Titel"
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "x" -x 50 -y 700
    set data [$pdf get]
    $pdf destroy
    regexp {/Producer\s*\(([^)]*)\)} $data -> info
    regexp {<pdf:Producer>([^<]*)<} $data -> xmp
    expr {$info ne "" && $info eq $xmp}
} -result 1

test pdfa-cw-1.3 {-producer schlaegt die Vorgabe auf beiden Seiten} -body {
    # Gegenprobe: die Vorgabe darf nicht ueberschreiben, was der Aufrufer
    # sagt -- und sie muss auf beiden Seiten dasselbe tun.
    set pdf [pdf4tcl::new %AUTO% -paper a4 -pdfa 3b -compress 0]
    $pdf metadata -title "T" -producer "Musterfirma Druck 2.1"
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "x" -x 50 -y 700
    set data [$pdf get]
    $pdf destroy
    regexp {/Producer\s*\(([^)]*)\)} $data -> info
    regexp {<pdf:Producer>([^<]*)<} $data -> xmp
    list $info $xmp
} -result {{Musterfirma Druck 2.1} {Musterfirma Druck 2.1}}

test pdfa-cw-1.4 {ohne -pdfa bleibt das Info-Dict unangetastet} -body {
    # Gegenprobe: die Aenderung darf nicht jedem Dokument einen Producer
    # aufdraengen, das gar keine Metadaten setzt.
    set pdf [pdf4tcl::new %AUTO% -paper a4 -compress 0]
    $pdf startPage
    $pdf setFont 10 Helvetica
    $pdf text "x" -x 50 -y 700
    set data [$pdf get]
    $pdf destroy
    expr {[string first "/Producer" $data] < 0}
} -result 1

::tcltest::cleanupTests